    "name": "sae/chasse-au-tresor",
    "description": "The central project will be a classified ads site.",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "api-platform/doctrine-orm": "^5.0.4",
        "api-platform/symfony": "^5.0.4",
        "doctrine/doctrine-bundle": "^3.3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.7.5",
        "endroid/qr-code-bundle": "^7.0.2",
        "knplabs/knp-paginator-bundle": "^6.11",
        "lelyfoto/twig-instanceof": "^1.3",
        "lexik/jwt-authentication-bundle": "^3.2",
        "nelmio/cors-bundle": "^2.6.1",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "phpstan/phpdoc-parser": "^2.3.6",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "^2.11",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/intl": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/mime": "7.4.*",
        "symfony/monolog-bundle": "^3.0|^4.1",
        "symfony/notifier": "7.4.*",
        "symfony/process": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/stimulus-bundle": "^3.6",
        "symfony/string": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/ux-google-map": "^3.6",
        "symfony/ux-turbo": "^3.6",
        "symfony/validator": "7.4.*",
        "symfony/web-link": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfonycasts/reset-password-bundle": "^1.25",
        "symfonycasts/verify-email-bundle": "^1.18",
        "twig/extra-bundle": "^2.12|^3.29",
        "twig/intl-extra": "^3.30",
        "twig/twig": "^2.12|^3.30"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpro/grumphp-shim": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpro/grumphp": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "make:jwt:keys": "php bin/console lexik:jwt:generate-keypair --skip-if-exists",
        "start" : [
            "Composer\\Config::disableProcessTimeout",
            "@make:jwt:keys",
            "symfony serve"
        ],
        "test:phpcs" : "php-cs-fixer fix --dry-run",
        "fix:phpcs": "php-cs-fixer fix",
        "test:twigcs": "twig-cs-fixer lint templates/",
        "fix:twigcs": "twig-cs-fixer fix templates/",
        "test:phpstan": [
            "vendor/bin/codecept build",
            "vendor/bin/phpstan analyse src tests"
        ],
        "test:yaml": "php bin/console lint:yaml config",
        "test:codeception": [
            "php vendor/bin/codecept clean",
            "bin/console doctrine:schema:drop --force --quiet --env=test",
            "bin/console doctrine:schema:create --quiet --env=test",
            "php vendor/bin/codecept run"
        ],
        "test" : [
            "@test:phpcs",
            "@test:twigcs",
            "@test:phpstan",
            "@test:yaml",
            "@test:codeception"
        ],
        "fix" : [
            "@fix:phpcs",
            "@fix:twigcs"
        ],
        "db": [
            "php bin/console doctrine:database:drop --force --if-exists",
            "php bin/console doctrine:database:create",
            "php bin/console doctrine:migrations:migrate --no-interaction",
            "php bin/console doctrine:fixtures:load --no-interaction"
        ],
        "fix:db": [
            "php bin/console doctrine:migrations:sync-metadata-storage",
            "php -r \"array_map('unlink', glob('migrations/*.php'));\"",
            "php bin/console doctrine:database:drop --force",
            "php bin/console doctrine:database:create",
            "php bin/console make:migration",
            "php bin/console doctrine:migrations:migrate --no-interaction",
            "composer db"
        ]
    },
    "scripts-descriptions": {
        "start": "Starts the Symfony server with timeout disabled",
        "test:phpcs": "Checks PHP code style without applying changes",
        "fix:phpcs": "Applies style fixes to PHP code",
        "test:twigcs": "Checks Twig code style without applying changes",
        "fix:twigcs": "Applies style fixes to Twig code",
        "test:phpstan": "Checks PHP code format depending on phpstan conditions",
        "test:yaml": "Does a verification for each yaml file within in config/",
        "test:codeception": "Run the code tests after initializing the test database",
        "test": "Runs all code checks",
        "fix": "Applies all code fixes",
        "db": "Recreates the DB, applies migrations, and loads fixtures",
        "fix:db": "Resets the DB and migration history, dropping and recreating the database, generating a fresh initial migration, and running database setup."
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "require-dev": {
        "codeception/codeception": "^5.3.7",
        "codeception/module-asserts": "^3.3",
        "codeception/module-doctrine": "^3.3",
        "codeception/module-rest": "^3.4.4",
        "codeception/module-symfony": "^3.11",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpro/grumphp": "^2.26",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.1",
        "phpstan/phpstan-beberlei-assert": "^2.0.2",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpunit/phpunit": "^13.4.3",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*",
        "vincentlanglet/twig-cs-fixer": "^4.1.1",
        "zenstruck/foundry": "^2.14.1"
    }
}
