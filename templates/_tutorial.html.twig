<div id="tutorial-overlay" class="tutorial-overlay d-none"></div>
<div id="tutorial-spotlight" class="tutorial-spotlight d-none"></div>
<div id="tutorial-tooltip" class="tutorial-tooltip d-none" role="dialog" aria-modal="true" aria-labelledby="tutorial-title">
    <div class="tutorial-tooltip-header">
        <span id="tutorial-step-count" class="tutorial-step-count"></span>
        <button type="button" id="tutorial-icon-close" class="tutorial-icon-close" aria-label="Fermer">&times;</button>
    </div>
    <h3 id="tutorial-title" class="tutorial-tooltip-title"></h3>
    <p id="tutorial-text" class="tutorial-tooltip-text"></p>
    <div class="tutorial-tooltip-actions">
        <button type="button" id="tutorial-btn-close" class="tutorial-btn-close">Fermer</button>
        <div class="tutorial-nav-buttons">
            <button type="button" id="tutorial-btn-prev" class="tutorial-btn-prev">Précédent</button>
            <button type="button" id="tutorial-btn-next" class="tutorial-btn-next">Suivant</button>
        </div>
    </div>
</div>
