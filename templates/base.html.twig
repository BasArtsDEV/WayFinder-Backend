<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>WayFinder | {{ block('title')|striptags }}</title>
    <link rel="icon" type="image/png" href="{{ asset('icons/app-icon.png') }}">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    <style>
        :root {
            --brand-primary: #10b981;
            --brand-dark: #111f1d;
            --footer-text: #94a3b8;
            --border-theme: rgba(255, 255, 255, 0.1);
        }

        .bg-theme-dark {
            background-color: var(--brand-dark) !important;
        }

        .border-theme {
            border-color: var(--border-theme) !important;
        }

        .fs-7 { font-size: 0.85rem; }
        .fs-8 { font-size: 0.75rem; }
        .tracking-wider { letter-spacing: 0.08em; }
        .hover-emerald { transition: color 0.2s ease-in-out; }
        .hover-emerald:hover { color: #34d399 !important; }

        .navbar-shadow {
            box-shadow: 0 15px 35px 2px rgba(0, 0, 0, 0.65) !important;
            z-index: 1030;
        }

        .footer-shadow {
            position: relative;
            box-shadow: 0 -15px 35px 2px rgba(0, 0, 0, 0.55) !important;
            z-index: 10;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-dark bg-theme-dark border-bottom border-theme sticky-top px-4 py-2 navbar-shadow">
    <div class="container-fluid align-items-center">

        <div class="d-flex align-items-center gap-3 col-lg-3">
            <a class="navbar-brand fw-bold fs-4 text-white m-0 d-flex align-items-center gap-2" href="{{ path('app_home') }}">
                <img src="{{ asset('icons/app-icon.png') }}"
                     alt="Logo WayFinder"
                     style="height: 34px; width: auto; object-fit: contain;"
                     class="rounded-2" />
                <span>WayFinder</span>
            </a>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill d-none d-xl-inline fs-8">Mode création</span>
        </div>

        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-between col-lg-9" id="navbarNav">

            {% set currentRoute = app.request.attributes.get('_route') %}
            <div class="navbar-nav align-items-lg-center gap-lg-2 my-2 my-lg-0">
                <a class="nav-link text-light opacity-75 px-3 py-2 rounded-3 fw-semibold d-flex align-items-center gap-2 {{ currentRoute == 'app_treasure_hunt' ? 'active text-white opacity-100' : '' }}"
                   href="{{ path('app_treasure_hunt') }}">
                    <i class="bi bi-map"></i>
                    <span>Créations</span>
                </a>

                <a class="nav-link text-light opacity-75 px-3 py-2 rounded-3 fw-semibold d-flex align-items-center gap-2 {{ currentRoute == 'app_team' ? 'active text-white opacity-100' : '' }}"
                   href="{{ path('app_team') }}">
                    <i class="bi bi-people"></i>
                    <span>Équipes</span>
                </a>
            </div>

            <form action="{{ path('app_treasure_hunt') }}" method="GET" class="search-bar-container my-2 my-lg-0" id="globalSearchForm">
                <div class="input-group">
                    <span class="input-group-text bg-white bg-opacity-10 border-0 text-light opacity-75"><i class="bi bi-search"></i></span>
                    <input type="search" name="q" value="{{ app.request.query.get('q') }}" class="form-control bg-white bg-opacity-10 border-0 text-white placeholder-glow" placeholder="Rechercher une chasse..." aria-label="Recherche">
                </div>
            </form>

            <div class="d-flex align-items-center gap-3">
                {% if app.user %}
                    <div class="nav-item dropdown">
                        <a class="btn btn-outline-light d-flex align-items-center gap-2 px-3 py-1.5 rounded-pill shadow-sm" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                            {{ include('profile/partials/_avatar.html.twig', {
                                user: app.user,
                                size: 30,
                            }) }}
                            <span class="fw-medium">@{{ app.user.username }}</span>
                        </a>

                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-dark bg-theme-dark border-theme shadow mt-2 p-2 rounded-3">
                            <div class="dropdown-header text-uppercase fs-7 fw-bold text-muted">Mon Compte</div>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2" href="{{ path('api_doc') }}">
                                    <i class="bi bi-code-slash" style="color: var(--brand-primary);"></i> Documentation API
                                </a>
                                <div class="dropdown-divider border-theme my-1"></div>
                            {% endif %}
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2" href="{{ path('app_profil') }}">
                                <i class="bi bi-person-circle"></i> Mon profil
                            </a>
                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger rounded-2" href="{{ logout_path() }}">
                                <i class="bi bi-box-arrow-right"></i> Déconnexion
                            </a>
                        </div>
                    </div>
                {% else %}
                    <a class="btn text-white px-4 py-2 rounded-pill fw-medium shadow-sm" style="background-color: var(--brand-primary); border: none;" href="{{ path('app_login') }}">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Connexion
                    </a>
                {% endif %}
            </div>

        </div>
    </div>
</nav>

<main class="flex-grow-1 d-flex flex-column">
    {% for success in app.flashes('success') %}
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                {{ success }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    {% endfor %}

    {% block main %}{% endblock %}
</main>

<footer class="pt-4 pb-3 bg-theme-dark border-top border-theme footer-shadow" style="color: var(--footer-text);">
    <div class="container">

        <div class="row gy-3 mb-3">
            <div class="col-lg-4 col-md-12">
                <span class="text-uppercase tracking-wider fw-bold fs-8 d-block mb-1" style="color: var(--brand-primary);">WAYFINDER</span>
                <h2 class="text-white fw-bold h4 mb-2">Votre terrain de jeu</h2>
                <p class="small mb-0 pe-lg-4 text-light opacity-75" style="line-height: 1.5;">
                    Transformez n'importe quel lieu en parcours interactif et vivez des aventures inédites en équipe.
                </p>
            </div>

            <div class="col-lg-2 col-md-3 col-6">
                <h6 class="text-uppercase fw-semibold fs-8 tracking-wider mb-2 text-light">Produit</h6>
                <ul class="list-unstyled small d-flex flex-column gap-1 mb-0">
                    <li><a href="#" class="text-light opacity-75 text-decoration-none hover-emerald">Comment ça marche</a></li>
                    <li><a href="#" class="text-light opacity-75 text-decoration-none hover-emerald">Créer un compte</a></li>
                </ul>
            </div>

            <div class="col-lg-2 col-md-3 col-6">
                <h6 class="text-uppercase fw-semibold fs-8 tracking-wider mb-2 text-light">Ressources</h6>
                <ul class="list-unstyled small d-flex flex-column gap-1 mb-0">
                    <li><a href="#" class="text-light opacity-75 text-decoration-none hover-emerald">Foire aux questions</a></li>
                    <li><a href="#" class="text-light opacity-75 text-decoration-none hover-emerald">Guides & Tutoriels</a></li>
                </ul>
            </div>

            <div class="col-lg-2 col-md-3 col-6">
                <h6 class="text-uppercase fw-semibold fs-8 tracking-wider mb-2 text-light">Société</h6>
                <ul class="list-unstyled small d-flex flex-column gap-1 mb-0">
                    <li><a href="#" class="text-light opacity-75 text-decoration-none hover-emerald">Nous contacter</a></li>
                    <li><a href="#" class="text-light opacity-75 text-decoration-none hover-emerald">Avis clients</a></li>
                </ul>
            </div>

            <div class="col-lg-2 col-md-3 col-6">
                <h6 class="text-uppercase fw-semibold fs-8 tracking-wider mb-2 text-light">Légal</h6>
                <ul class="list-unstyled small d-flex flex-column gap-1 mb-0">
                    <li><a href="#" class="text-light opacity-75 text-decoration-none hover-emerald">Conditions d'utilisation</a></li>
                    <li><a href="#" class="text-light opacity-75 text-decoration-none hover-emerald">Mentions légales</a></li>
                </ul>
            </div>
        </div>

        <div class="row align-items-center py-2 mb-2 gy-2 border-top border-bottom border-theme">
            <div class="col-md-6 text-center text-md-start">
                <div class="d-flex gap-2 justify-content-center justify-content-md-start align-items-center">
                    <span class="text-uppercase fw-bold fs-8 tracking-wider me-2" style="color: var(--brand-primary);">Application :</span>
                    <a href="#" class="btn btn-sm text-light d-inline-flex align-items-center gap-2 px-2 py-1 rounded-2 border-theme bg-white bg-opacity-10">
                        <i class="bi bi-apple fs-6"></i>
                        <span class="fw-medium fs-8">App Store</span>
                    </a>
                    <a href="#" class="btn btn-sm text-light d-inline-flex align-items-center gap-2 px-2 py-1 rounded-2 border-theme bg-white bg-opacity-10">
                        <i class="bi bi-google-play fs-6"></i>
                        <span class="fw-medium fs-8">Google Play</span>
                    </a>
                </div>
            </div>

            <div class="col-md-6 text-center text-md-end">
                <div class="d-flex gap-3 justify-content-center justify-content-md-end fs-6">
                    <a href="#" class="text-light opacity-75 hover-emerald"><i class="bi bi-linkedin"></i></a>
                    <a href="#" class="text-light opacity-75 hover-emerald"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-light opacity-75 hover-emerald"><i class="bi bi-twitter"></i></a>
                    <a href="#" class="text-light opacity-75 hover-emerald"><i class="bi bi-facebook"></i></a>
                </div>
            </div>
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center fs-8 text-light opacity-50">
            <p class="mb-1 mb-md-0">WayFinder &copy; {{ 'now'|date('Y') }} Tous droits réservés.</p>
            <p class="mb-0">Aventures & Chasses au trésor interactives.</p>
        </div>

    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
