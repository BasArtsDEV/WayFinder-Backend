<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>WayFinder | {{ block('title')|striptags }}</title>
    <link rel="icon" type="image/png" href="{{ asset('icons/app-icon.png') }}">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    {% block stylesheets %}

    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-dark bg-theme-dark border-bottom border-theme sticky-top px-4 py-2 navbar-shadow">
    <div class="container-fluid align-items-center position-relative">

        <div class="d-flex align-items-center gap-3">
            <a class="navbar-brand fw-bold fs-4 text-white m-0 d-flex align-items-center gap-2" href="{{ path('app_home') }}">
                <img src="{{ asset('icons/app-icon.png') }}"
                     alt="Logo WayFinder"
                     style="height: 34px; width: auto; object-fit: contain;"
                     class="rounded-2" />
                <span>WayFinder</span>
            </a>
            <span class="badge bg-white bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 rounded-pill d-none d-xl-inline fs-8">Mode création</span>        </div>

        <button class="navbar-toggler border-0 shadow-none ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">

            {% set currentRoute = app.request.attributes.get('_route') %}
            <div class="navbar-nav align-items-lg-center gap-lg-2 my-2 my-lg-0 navbar-centered-links">
                <a class="nav-link text-light opacity-75 px-3 py-2 rounded-3 fw-semibold d-flex align-items-center gap-2 {{ currentRoute == 'app_treasure_hunt_mine' ? 'active text-white opacity-100' : '' }}"
                   href="{{ path('app_treasure_hunt_mine') }}">
                    <i class="bi bi-map"></i>
                    <span>Créations</span>
                </a>

                <a class="nav-link text-light opacity-75 px-3 py-2 rounded-3 fw-semibold d-flex align-items-center gap-2 {{ currentRoute == 'app_team' ? 'active text-white opacity-100' : '' }}"
                   href="{{ path('app_team') }}">
                    <i class="bi bi-people"></i>
                    <span>Équipes</span>
                </a>
            </div>

            <div class="d-flex align-items-center gap-3 ms-lg-auto">
                {% if app.user %}
                    <div class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-2 p-0 custom-profile-toggle"
                           href="#"
                           id="userDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <div class="profile-avatar-container">
                                {{ include('profile/partials/_avatar.html.twig', {
                                    user: app.user,
                                    size: 38,
                                }) }}
                            </div>
                            <i class="bi bi-caret-down-fill crunchy-arrow"></i>
                        </a>

                        <div class="dropdown-menu dropdown-menu-end dropdown-menu crunchy-dropdown shadow-lg mt-2 p-0 rounded-3 border-0" aria-labelledby="userDropdown">

                            <div class="p-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="profile-avatar-container">
                                        {{ include('profile/partials/_avatar.html.twig', {
                                            user: app.user,
                                            size: 48,
                                        }) }}
                                    </div>
                                    <span class="fw-bold fs-5 text-light">@{{ app.user.username }}</span>
                                </div>
                                <a href="{{ path('app_profil') }}"><i class="app-dropdown-icon bi bi-pencil fs-6 text-light"></i></a>
                            </div>

                            <div class="dropdown-section p-2 border-top border-theme">
                                <a class="dropdown-item d-flex align-items-center gap-3 py-2 px-3 rounded-2 text-light" href="{{ path('app_profil') }}">
                                    <i class="bi bi-gear fs-5"></i>
                                    <span>Paramètres</span>
                                </a>
                            </div>

                            <div class="dropdown-section p-2 border-top border-theme">
                                <a class="dropdown-item d-flex align-items-center gap-3 py-2 px-3 rounded-2 text-warning" href="#">
                                    <i class="bi bi-bookmark-fill fs-5"></i>
                                    <span>Mes favoris</span>
                                </a>
                                <a class="dropdown-item d-flex align-items-center gap-3 py-2 px-3 rounded-2  text-light" href="{{ path('app_treasure_hunt_mine') }}">
                                    <i class="bi bi-map"></i>
                                    <span>Mes chasses</span>
                                </a>
                                <a class="dropdown-item d-flex align-items-center gap-3 py-2 px-3 rounded-2  text-light" href="#">
                                    <i class="bi bi-people"></i>
                                    <span>Mes équipes</span>
                                </a>
                            </div>

                            <div class="dropdown-section p-2 border-top border-theme">
                                <a class="dropdown-item d-flex align-items-center gap-3 py-2 px-3 rounded-2  text-light" href="#">
                                    <i class="bi bi-bell fs-5"></i>
                                    <span>Notifications</span>
                                </a>
                            </div>

                            <div class="dropdown-section p-2 border-top border-theme">
                                <a class="dropdown-item d-flex align-items-center gap-3 py-2 px-3 rounded-2  text-light" href="{{ logout_path() }}">
                                    <i class="bi bi-box-arrow-right fs-5"></i>
                                    <span>Se déconnecter</span>
                                </a>
                            </div>

                        </div>
                    </div>
                {% else %}
                    <a class="btn-app-secondary" style="background-color: var(--brand-primary); border: none;" href="{{ path('app_login') }}">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Connexion
                    </a>
                {% endif %}
            </div>

        </div>
    </div>
</nav>

<main class="flex-grow-1 d-flex flex-column">

    {% for label, messages in app.flashes %}
        {% set alertClass = label == 'error' ? 'danger' : label %}
        {% for message in messages %}
            <div class="container mt-3">
                <div class="alert alert-{{ alertClass }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    {% block main %}{% endblock %}
</main>

<footer class="pt-4 pb-3 bg-theme-dark border-top border-theme footer-shadow" style="color: var(--footer-text);">
    <div class="container">

        <div class="row gy-3 mb-3">
            <div class="col-lg-4 col-md-12">
                <span class="text-uppercase tracking-wider fw-bold fs-8 d-block mb-1" style="color: var(--brand-primary);">WAYFINDER</span>
                <h2 class="text-white fw-bold h4 mb-2">Votre terrain de jeu</h2>
            </div>

            <div class="col-lg-2 col-md-3 col-6">
                <span class="text-uppercase tracking-wider fw-bold fs-8 d-block mb-1 invisible" aria-hidden="true">WAYFINDER</span>
                <h6 class="text-uppercase fw-semibold fs-8 tracking-wider mb-2 text-light">Produit</h6>
                <ul class="list-unstyled small d-flex flex-column gap-1 mb-0">
                    <li><a href="#" class="text-light opacity-75 text-decoration-none hover-emerald">Créer un compte</a></li>
                </ul>
            </div>

            <div class="col-lg-2 col-md-3 col-6">
                <span class="text-uppercase tracking-wider fw-bold fs-8 d-block mb-1 invisible" aria-hidden="true">WAYFINDER</span>
                <h6 class="text-uppercase fw-semibold fs-8 tracking-wider mb-2 text-light">Ressources</h6>
                <ul class="list-unstyled small d-flex flex-column gap-1 mb-0">
                    <li><a href="#" class="text-light opacity-75 text-decoration-none hover-emerald">Foire aux questions</a></li>
                </ul>
            </div>

            <div class="col-lg-2 col-md-3 col-6">
                <span class="text-uppercase tracking-wider fw-bold fs-8 d-block mb-1 invisible" aria-hidden="true">WAYFINDER</span>
                <h6 class="text-uppercase fw-semibold fs-8 tracking-wider mb-2 text-light">Société</h6>
                <ul class="list-unstyled small d-flex flex-column gap-1 mb-0">
                    <li><a href="#" class="text-light opacity-75 text-decoration-none hover-emerald">Nous contacter</a></li>
                </ul>
            </div>

            <div class="col-lg-2 col-md-3 col-6">
                <span class="text-uppercase tracking-wider fw-bold fs-8 d-block mb-1 invisible" aria-hidden="true">WAYFINDER</span>
                <h6 class="text-uppercase fw-semibold fs-8 tracking-wider mb-2 text-light">Légal</h6>
                <ul class="list-unstyled small d-flex flex-column gap-1 mb-0">
                    <li><a href="#" class="text-light opacity-75 text-decoration-none hover-emerald">Mentions légales</a></li>
                </ul>
            </div>
        </div>

        <div class="row align-items-center py-2 mb-2 gy-2 border-top border-bottom border-theme">
            <div class="col-md-6 text-center text-md-start">
                <div class="d-flex gap-2 justify-content-center justify-content-md-start align-items-center">
                    <a href="#" class="btn btn-sm text-light d-inline-flex align-items-center gap-2 px-2 py-1 rounded-2 border-theme bg-white bg-opacity-10">
                        <i class="bi bi-apple fs-6"></i>
                        <span class="fw-medium fs-8">App Store</span>
                    </a>
                    <a href="#" class="btn btn-sm text-light d-inline-flex align-items-center gap-2 px-2 py-1 rounded-2 border-theme bg-white bg-opacity-10">
                        <i class="bi bi-google-play fs-6"></i>
                        <span class="fw-medium fs-8">Google Play</span>
                    </a>
                </div>
            </div>

            <div class="col-md-6 text-center text-md-end">
                <div class="d-flex gap-3 justify-content-center justify-content-md-end fs-6">
                    <a href="#" class="text-light opacity-75 hover-emerald"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-light opacity-75 hover-emerald"><i class="bi bi-twitter"></i></a>
                    <a href="#" class="text-light opacity-75 hover-emerald"><i class="bi bi-facebook"></i></a>
                </div>
            </div>
        </div>

        <div class="d-flex flex-flex-column flex-md-row justify-content-between align-items-center fs-8 text-light opacity-50">
            <p class="mb-1 mb-md-0">WayFinder &copy; {{ 'now'|date('Y') }} Tous droits réservés.</p>
            <p class="mb-0">Aventures & Chasses au trésor interactives.</p>
        </div>

    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
