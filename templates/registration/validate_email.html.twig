{% extends 'base.html.twig' %}

{% block title %}{{ 'validate_email.title'|trans }}{% endblock %}

{% block main %}
    <div class="card d-flex flex-column align-items-center m-auto p-4 border border-dark">
        <h1>{{ 'validate_email.heading'|trans }}</h1>

        <p class="m-0">{{ 'validate_email.not_validated'|trans }}</p>
        <p>{{ 'validate_email.instructions'|trans }}</p>

        <div class="mt-4">
            {{ form_start(validationForm) }}
            <button type="submit" class="btn btn-primary">{{ 'validate_email.resend'|trans }}</button>
            {{ form_end(validationForm) }}
        </div>
    </div>
{% endblock %}
