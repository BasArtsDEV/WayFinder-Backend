{% extends 'base.html.twig' %}

{% block title %}Confirmer mon adresse e-mail{% endblock %}

{% block main %}
    <div class="card d-flex flex-column align-items-center m-auto p-4 border border-dark">
        <h1>Confirmez votre adresse e-mail</h1>

        <p class="m-0">Votre adresse e-mail n&apos;a pas encore été validée.</p>
        <p>Veuillez cliquer sur le bouton ci-dessous pour recevoir un nouvel e-mail de confirmation.</p>

        <div class="mt-4">
            {{ form_start(validationForm) }}
                <button type="submit" class="btn btn-primary">Renvoyer l&apos;e-mail de confirmation</button>
            {{ form_end(validationForm) }}
        </div>
    </div>
{% endblock %}
