{% extends 'base.html.twig' %}

{% block title %}S'inscrire{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('styles/security/register.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block main %}
    <div class="login-page-wrapper">
        <div class="login-card register-card">
            <div class="user-avatar-badge">
                <i class="bi bi-person-plus-fill"></i>
            </div>

            <h1 class="login-title">Créer un compte</h1>

            {% if form_errors(registrationForm) %}
                <div class="alert alert-danger mx-3 my-2 text-center py-2 fs-7">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}

            {{ form_start(registrationForm, {attr: {class: 'login-form'}}) }}

            <div class="form-group mb-3">
                <label for="{{ registrationForm.username.vars.id }}" class="form-label-custom">Nom d'utilisateur</label>
                <div class="input-badge-group">
                    <span class="input-badge-icon">
                        <i class="bi bi-at"></i>
                    </span>
                    {{ form_widget(registrationForm.username, {
                        attr: {
                            class: 'form-control-custom',
                            placeholder: 'JohnDoe',
                        },
                    }) }}
                </div>
                {{ form_errors(registrationForm.username) }}
            </div>

            <div class="form-group mb-3">
                <label for="{{ registrationForm.email.vars.id }}" class="form-label-custom">Adresse e-mail</label>
                <div class="input-badge-group">
                    <span class="input-badge-icon">
                        <i class="bi bi-envelope-fill"></i>
                    </span>
                    {{ form_widget(registrationForm.email, {
                        attr: {
                            class: 'form-control-custom',
                            placeholder: 'example@gmail.com',
                        },
                    }) }}
                </div>
                {{ form_errors(registrationForm.email) }}
            </div>

            <div class="row g-2 mb-3">
                <div class="col-12 col-md-6">
                    <label for="{{ registrationForm.firstname.vars.id }}" class="form-label-custom">Prénom</label>
                    <div class="input-badge-group">
                        <span class="input-badge-icon">
                            <i class="bi bi-person-fill"></i>
                        </span>
                        {{ form_widget(registrationForm.firstname, {
                            attr: {
                                class: 'form-control-custom',
                                placeholder: 'Jean',
                            },
                        }) }}
                    </div>
                    {{ form_errors(registrationForm.firstname) }}
                </div>
                <div class="col-12 col-md-6">
                    <label for="{{ registrationForm.lastname.vars.id }}" class="form-label-custom">Nom</label>
                    <div class="input-badge-group">
                        <span class="input-badge-icon">
                            <i class="bi bi-person-vcard-fill"></i>
                        </span>
                        {{ form_widget(registrationForm.lastname, {
                            attr: {
                                class: 'form-control-custom',
                                placeholder: 'Dupont',
                            },
                        }) }}
                    </div>
                    {{ form_errors(registrationForm.lastname) }}
                </div>
            </div>

            {% if registrationForm.password.first is defined %}
                <div class="form-group mb-3">
                    <label for="{{ registrationForm.password.first.vars.id }}" class="form-label-custom">Mot de passe</label>
                    <div class="input-badge-group">
                        <span class="input-badge-icon">
                            <i class="bi bi-lock-fill"></i>
                        </span>
                        {{ form_widget(registrationForm.password.first, {
                            attr: {
                                class: 'form-control-custom',
                                placeholder: 'Choisissez un mot de passe',
                            },
                        }) }}
                    </div>
                    {{ form_errors(registrationForm.password.first) }}
                </div>

                <div class="form-group mb-4">
                    <label for="{{ registrationForm.password.second.vars.id }}" class="form-label-custom">Confirmer le mot de passe</label>
                    <div class="input-badge-group">
                        <span class="input-badge-icon">
                            <i class="bi bi-check2-circle"></i>
                        </span>
                        {{ form_widget(registrationForm.password.second, {
                            attr: {
                                class: 'form-control-custom',
                                placeholder: 'Répétez votre mot de passe',
                            },
                        }) }}
                    </div>
                    {{ form_errors(registrationForm.password.second) }}
                </div>
            {% else %}
                <div class="form-group mb-4">
                    <label for="{{ registrationForm.password.vars.id }}" class="form-label-custom">Mot de passe</label>
                    <div class="input-badge-group">
                        <span class="input-badge-icon">
                            <i class="bi bi-lock-fill"></i>
                        </span>
                        {{ form_widget(registrationForm.password, {
                            attr: {
                                class: 'form-control-custom',
                                placeholder: 'Choisissez un mot de passe',
                            },
                        }) }}
                    </div>
                    {{ form_errors(registrationForm.password) }}
                </div>
            {% endif %}

            <button type="submit" class="btn-app-primary btn-login-submit" style="justify-content: center;">
                <i class="bi bi-plus-circle-fill"></i>
                S'inscrire
            </button>

            <div class="text-center mt-3 flex-row">
                <p style="margin-bottom: 0">Vous avez déjà un compte ?</p>
                <a href="{{ path('app_login') }}" class="btn-app-hypertext">
                    Se connecter
                </a>
            </div>

            {{ form_end(registrationForm) }}
        </div>
    </div>
{% endblock %}
