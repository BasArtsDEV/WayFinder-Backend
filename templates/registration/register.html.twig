{% extends 'base.html.twig' %}

{% block title %}S&apos;inscrire{% endblock %}

{% block main %}
    <div class="min-vh-100 d-flex justify-content-center align-items-center mx-auto">
        <div class="p-4" style="width: 75%;">
            <h1 class="mb-4 text-center">Créer mon compte</h1>
            {{ form_errors(registrationForm) }}
            {{ form_start(registrationForm) }}
                {{ form_row(registrationForm.username) }}
                {{ form_row(registrationForm.email) }}
                <div class="d-flex flex-column flex-md-row gap-md-3">
                    <div class="flex-fill">{{ form_row(registrationForm.firstname) }}</div>
                    <div class="flex-fill">{{ form_row(registrationForm.lastname) }}</div>
                </div>

                {{ form_row(registrationForm.password) }}

                <div class="d-flex flex-column flex-md-row gap-3 justify-content-center mt-4">
                    <button type="submit" class="btn btn-lg btn-success rounded-pill">
                        <i class="bi bi-check-circle-fill pe-3"></i>
                        Valider
                    </button>

                    <a class="btn btn-lg btn-success rounded-pill text-decoration-none" href="{{ path('app_login') }}">
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Se connecter
                    </a>
                </div>
            {{ form_end(registrationForm) }}
        </div>
    </div>
{% endblock %}
