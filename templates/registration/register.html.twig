{% extends 'base.html.twig' %}

{% block title %}S'inscrire{% endblock %}

{% block main %}
    <div class="login-page-wrapper">
        <div class="login-card register-card">
            <div class="user-avatar-badge">
                <i class="bi bi-person-plus-fill"></i>
            </div>

            <h1 class="login-title">CRÉER UN COMPTE</h1>

            {% if form_errors(registrationForm) %}
                <div class="alert alert-danger mx-3 my-2 text-center py-2 fs-7">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}

            {{ form_start(registrationForm, {attr: {class: 'login-form'}}) }}

            <div class="form-group mb-3">
                <label for="{{ registrationForm.username.vars.id }}" class="form-label-custom">Nom d'utilisateur</label>
                <div class="input-badge-group">
                    <span class="input-badge-icon">
                        <i class="bi bi-at"></i>
                    </span>
                    {{ form_widget(registrationForm.username, {
                        attr: {
                            class: 'form-control-custom',
                            placeholder: 'JohnDoe',
                        },
                    }) }}
                </div>
                {{ form_errors(registrationForm.username) }}
            </div>

            <div class="form-group mb-3">
                <label for="{{ registrationForm.email.vars.id }}" class="form-label-custom">Adresse e-mail</label>
                <div class="input-badge-group">
                    <span class="input-badge-icon">
                        <i class="bi bi-envelope-fill"></i>
                    </span>
                    {{ form_widget(registrationForm.email, {
                        attr: {
                            class: 'form-control-custom',
                            placeholder: 'example@gmail.com',
                        },
                    }) }}
                </div>
                {{ form_errors(registrationForm.email) }}
            </div>

            <div class="row g-2 mb-3">
                <div class="col-12 col-md-6">
                    <label for="{{ registrationForm.firstname.vars.id }}" class="form-label-custom">Prénom</label>
                    <div class="input-badge-group">
                        <span class="input-badge-icon">
                            <i class="bi bi-person-fill"></i>
                        </span>
                        {{ form_widget(registrationForm.firstname, {
                            attr: {
                                class: 'form-control-custom',
                                placeholder: 'Jean',
                            },
                        }) }}
                    </div>
                    {{ form_errors(registrationForm.firstname) }}
                </div>
                <div class="col-12 col-md-6">
                    <label for="{{ registrationForm.lastname.vars.id }}" class="form-label-custom">Nom</label>
                    <div class="input-badge-group">
                        <span class="input-badge-icon">
                            <i class="bi bi-person-vcard-fill"></i>
                        </span>
                        {{ form_widget(registrationForm.lastname, {
                            attr: {
                                class: 'form-control-custom',
                                placeholder: 'Dupont',
                            },
                        }) }}
                    </div>
                    {{ form_errors(registrationForm.lastname) }}
                </div>
            </div>

            {% if registrationForm.password.first is defined %}
                <div class="form-group mb-3">
                    <label for="{{ registrationForm.password.first.vars.id }}" class="form-label-custom">Mot de passe</label>
                    <div class="input-badge-group">
                        <span class="input-badge-icon">
                            <i class="bi bi-lock-fill"></i>
                        </span>
                        {{ form_widget(registrationForm.password.first, {
                            attr: {
                                class: 'form-control-custom',
                                placeholder: 'Choisissez un mot de passe',
                            },
                        }) }}
                    </div>
                    {{ form_errors(registrationForm.password.first) }}
                </div>

                <div class="form-group mb-4">
                    <label for="{{ registrationForm.password.second.vars.id }}" class="form-label-custom">Confirmer le mot de passe</label>
                    <div class="input-badge-group">
                        <span class="input-badge-icon">
                            <i class="bi bi-check2-circle"></i>
                        </span>
                        {{ form_widget(registrationForm.password.second, {
                            attr: {
                                class: 'form-control-custom',
                                placeholder: 'Répétez votre mot de passe',
                            },
                        }) }}
                    </div>
                    {{ form_errors(registrationForm.password.second) }}
                </div>
            {% else %}
                <div class="form-group mb-4">
                    <label for="{{ registrationForm.password.vars.id }}" class="form-label-custom">Mot de passe</label>
                    <div class="input-badge-group">
                        <span class="input-badge-icon">
                            <i class="bi bi-lock-fill"></i>
                        </span>
                        {{ form_widget(registrationForm.password, {
                            attr: {
                                class: 'form-control-custom',
                                placeholder: 'Choisissez un mot de passe',
                            },
                        }) }}
                    </div>
                    {{ form_errors(registrationForm.password) }}
                </div>
            {% endif %}

            <button type="submit" class="btn btn-login-submit">
                S'INSCRIRE
            </button>

            <div class="text-center mt-3">
                <a href="{{ path('app_login') }}" class="text-decoration-none text-secondary small hover-green">
                    Déjà un compte ? <strong class="text-success">Se connecter</strong>
                </a>
            </div>

            {{ form_end(registrationForm) }}
        </div>
    </div>

    <style>
        .login-page-wrapper {
            width: 100%;
            flex-grow: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 3rem 1rem;
            box-sizing: border-box;
        }

        .login-card {
            position: relative;
            width: 100%;
            max-width: 420px;
            background-color: #ffffff;
            border-radius: 28px;
            padding: 4.5rem 2.25rem 4.5rem 2.25rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
            overflow: hidden;
            box-sizing: border-box;
        }

        .register-card {
            max-width: 520px;
        }

        .login-card::before,
        .login-card::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            height: 90px;
            z-index: 1;
            pointer-events: none;
        }

        .login-card::before {
            top: 0;
            background: linear-gradient(135deg, #2e7d32 0%, #388e3c 50%, #43a047 100%);
            clip-path: polygon(0 0, 100% 0, 100% 65%, 78% 35%, 50% 60%, 22% 35%, 0 65%);
        }

        .login-card::after {
            bottom: 0;
            background: linear-gradient(45deg, #2e7d32 0%, #388e3c 50%, #43a047 100%);
            clip-path: polygon(0 35%, 22% 65%, 50% 40%, 78% 65%, 100% 35%, 100% 100%, 0 100%);
        }

        .user-avatar-badge {
            position: absolute;
            top: 18px;
            left: 50%;
            transform: translateX(-50%);
            width: 72px;
            height: 72px;
            background-color: #2c2c2c;
            border: 4px solid #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 2.2rem;
            z-index: 2;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        }

        .login-title {
            position: relative;
            z-index: 2;
            text-align: center;
            font-size: 1.65rem;
            font-weight: 800;
            color: #2e7d32;
            margin-top: 0.5rem;
            margin-bottom: 2rem;
            letter-spacing: 0.05em;
        }

        .login-form {
            position: relative;
            z-index: 2;
        }

        .form-label-custom {
            display: block;
            font-size: 0.88rem;
            font-weight: 700;
            color: #2c2c2c;
            margin-bottom: 0.35rem;
        }

        .input-badge-group {
            display: flex;
            align-items: center;
            background-color: #e2e8f0;
            border-radius: 12px;
            overflow: hidden;
            height: 48px;
        }

        .input-badge-icon {
            width: 48px;
            height: 100%;
            background-color: #2e7d32;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .form-control-custom {
            flex-grow: 1;
            height: 100%;
            border: none;
            background: transparent;
            padding: 0 1rem;
            font-size: 0.92rem;
            color: #2d3748;
            outline: none;
            width: 100%;
        }

        .form-control-custom::placeholder {
            color: #a0aec0;
        }

        .btn-login-submit {
            width: 100%;
            height: 48px;
            background-color: #2e7d32;
            color: #ffffff;
            border: none;
            border-radius: 24px;
            font-weight: 800;
            font-size: 1.05rem;
            letter-spacing: 0.05em;
            transition: all 0.2s ease-in-out;
            box-shadow: 0 4px 12px rgba(46, 125, 50, 0.25);
            cursor: pointer;
        }

        .btn-login-submit:hover {
            background-color: #256628;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(46, 125, 50, 0.35);
        }

        .hover-green:hover {
            color: #2e7d32 !important;
        }

        @media (max-width: 576px) {
            .login-card,
            .register-card {
                max-width: 100%;
                padding-left: 1.25rem;
                padding-right: 1.25rem;
            }
        }
    </style>
{% endblock %}
