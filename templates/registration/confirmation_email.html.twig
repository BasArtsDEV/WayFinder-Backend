<h1>{{ 'email.confirmation.heading'|trans }}</h1>

<p>
    {{ 'email.confirmation.instructions'|trans }} <br><br>
    <a href="{{ signedUrl }}">{{ 'email.confirmation.link'|trans }}</a>
</p>

<p>
    {{ 'email.confirmation.expires'|trans({ duration: expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle') }) }}
</p>

<p>
    {{ 'email.signature.regards'|trans }} <br>
    {{ 'email.signature.team'|trans }}
</p>
