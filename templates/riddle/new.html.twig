{% extends 'base.html.twig' %}

{% set type_labels = {
    text: 'riddle.new.type.text',
    qcm: 'riddle.new.type.qcm',
    gps: 'riddle.new.type.gps',
    qrcode: 'riddle.new.type.qrcode',
} %}

{% set type_label = type_labels[type] ?? 'riddle.new.type.default' %}

{% block title %}{{ 'riddle.new.title'|trans({ type: type_label|trans }) }}{% endblock %}

{% block main %}
    {{ include('riddle/partials/_form.html.twig', {
        form: form,
        is_edit: false,
        type_label: type_label,
        hunt_id: hunt.id,
    }) }}
{% endblock %}
