{% extends 'base.html.twig' %}

{% block title %}Éditer l'énigme{% endblock %}

{% block main %}
    <div class="container my-4">
        <h2>Éditer l'énigme : {{ riddle.title }}</h2>

        {{ form_start(form) }}
        {{ form_widget(form) }}

        <button type="submit" class="btn btn-primary mt-3">Mettre à jour</button>
        <a href="{{ path('app_treasure_hunt_edit', {id: riddle.treasureHunt.id}) }}" class="btn btn-secondary mt-3">Annuler</a>
        {{ form_end(form) }}

        <form action="{{ path('app_riddle_delete', {id: riddle.id}) }}" method="POST" class="mt-4" onsubmit="return confirm('Confirmer la suppression ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ riddle.id) }}">
            <button type="submit" class="btn btn-danger">Supprimer l'énigme</button>
        </form>
    </div>
{% endblock %}
