{% extends 'base.html.twig' %}

{% block title %}Liste des équipes{% endblock %}

{% block main %}
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 fw-bold mb-0">Équipes</h1>
            <a href="{{ path('app_team_new') }}" class="btn-app-primary">
                <i class="bi bi-plus-circle"></i> Créer une équipe
            </a>
        </div>

        {% if myTeams is not empty %}
            <h2 class="h5 fw-semibold mb-3">Mes équipes</h2>
            <div class="row g-4 mb-5">
                {% for team in myTeams %}
                    <div class="col-12 col-md-6 col-lg-4">
                        {{ include('team/partials/_team_card.html.twig', { team: team }) }}
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <h2 class="h5 fw-semibold mb-3">{{ myTeams is empty ? 'Toutes les équipes' : 'Autres équipes' }}</h2>
        <div class="row g-4">
            {% for team in otherTeams %}
                <div class="col-12 col-md-6 col-lg-4">
                    {{ include('team/partials/_team_card.html.twig', { team: team }) }}
                </div>
            {% else %}
                <p class="text-muted">Aucune équipe pour le moment.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
