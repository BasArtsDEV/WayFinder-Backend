{% extends 'base.html.twig' %}

{% block title %}{{ 'team.list.title'|trans }}{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('styles/team/list.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block main %}
    <div class="container py-5">
        <div class="page-header">
            <h1 class="h3 fw-bold mb-0">
                {{ 'team.list.count'|trans({ count: teams.totalItemCount }) }}
                {% if q %}
                    {{ 'team.list.for_query'|trans({ query: q }) }}
                    <a href="{{ path('app_team', { filter: currentFilter.value == 'all' ? null : currentFilter.value }) }}" class="text-decoration-none ms-1">
                        <i class="bi bi-x-circle"></i>
                    </a>
                {% endif %}
            </h1>
            <a href="{{ path('app_team_new') }}" class="btn-app-primary">
                <i class="bi bi-plus-circle"></i> {{ 'team.list.create'|trans }}
            </a>
        </div>

        <div class="card border-0 rounded-4 p-3 p-md-4 bg-white team-list-box">
            <form method="get" action="{{ path('app_team') }}" role="search" class="row g-3 align-items-center mb-4">
                <input type="hidden" name="filter" value="{{ currentFilter.value }}">

                <div class="col-12 col-lg">
                    <div class="col-12 col-lg">
                        <div class="d-flex gap-2">
                            <input type="search" name="q" value="{{ q }}" maxlength="50"
                                   class="form-control" placeholder="{{ 'team.list.search_placeholder'|trans }}"
                                   aria-label="{{ 'team.list.search_label'|trans }}">
                            <button type="submit" class="btn-app-primary flex-shrink-0" aria-label="{{ 'common.search'|trans }}">
                                <i class="bi bi-search" aria-hidden="true"></i><span class="d-none d-sm-inline">{{ 'common.search'|trans }}</span>
                            </button>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="btn-group gap-2" role="group" aria-label="{{ 'team.list.filter_label'|trans }}">
                            {% for f in enum_cases('App\\Enum\\TeamFilter') %}
                                <a href="{{ path('app_team', { filter: f.value == 'all' ? null : f.value, q: q ?: null }) }}"
                                   class="btn {{ f == currentFilter ? 'btn-app-primary' : 'btn-app-secondary' }}"
                                   {% if f == currentFilter %}aria-current="true"{% endif %}>
                                    {{ f.label|trans }}
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </form>

            <div class="row g-4">
                {% for team in teams %}
                    <div class="col-12 col-md-6 col-lg-4">
                        {{ include('team/partials/_team_card.html.twig', { team: team }) }}
                    </div>
                {% else %}
                    <div class="col-12 text-center text-muted py-5">
                        <i class="bi bi-people fs-1 d-block mb-2"></i>
                        {{ 'team.list.empty'|trans }}
                    </div>
                {% endfor %}
            </div>

            <div class="d-flex justify-content-center mt-4">
                {{ knp_pagination_render(teams) }}
            </div>
        </div>
    </div>
{% endblock %}
