{% extends 'base.html.twig' %}

{% block title %}Liste des équipes{% endblock %}

{% block main %}
    <div class="container py-5">
        <div class="page-header">
            <h1 class="h3 fw-bold mb-0">
                {{ teams.totalItemCount }} équipe{{ teams.totalItemCount > 1 ? 's' : '' }}
                {% if q %}
                    pour « {{ q }} »
                    <a href="{{ path('app_team', { filter: currentFilter.value == 'all' ? null : currentFilter.value }) }}" class="text-decoration-none ms-1">
                        <i class="bi bi-x-circle"></i>
                    </a>
                {% endif %}
            </h1>
            <a href="{{ path('app_team_new') }}" class="btn-app-primary">
                <i class="bi bi-plus-circle"></i> Créer une équipe
            </a>
        </div>

        <form method="get" action="{{ path('app_team') }}" role="search" class="row g-3 align-items-center mb-4">
            <input type="hidden" name="filter" value="{{ currentFilter.value }}">

            <div class="col-12 col-lg">
                <div class="col-12 col-lg">
                    <div class="d-flex gap-2">
                        <input type="search" name="q" value="{{ q }}" maxlength="50"
                               class="form-control" placeholder="Rechercher une équipe ou un chef…"
                               aria-label="Rechercher une équipe">
                        <button type="submit" class="btn-app-primary flex-shrink-0" aria-label="Rechercher">
                            <i class="bi bi-search" aria-hidden="true"></i><span class="d-none d-sm-inline">Rechercher</span>
                        </button>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="btn-group gap-2" role="group" aria-label="Filtrer les équipes">
                        {% for f in enum_cases('App\\Enum\\TeamFilter') %}
                            <a href="{{ path('app_team', { filter: f.value == 'all' ? null : f.value, q: q ?: null }) }}"
                               class="btn {{ f == currentFilter ? 'btn-app-primary' : 'btn-app-secondary' }}"
                               {% if f == currentFilter %}aria-current="true"{% endif %}>
                                {{ f.label }}
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </form>

        <div class="row g-4">
            {% for team in teams %}
                <div class="col-12 col-md-6 col-lg-4">
                    {{ include('team/partials/_team_card.html.twig', { team: team }) }}
                </div>
            {% else %}
                <div class="col-12 text-center text-muted py-5">
                    <i class="bi bi-people fs-1 d-block mb-2"></i>
                    Aucune équipe ne correspond à votre recherche.
                </div>
            {% endfor %}
        </div>

        <div class="d-flex justify-content-center mt-4">
            {{ knp_pagination_render(teams) }}
        </div>
    </div>
{% endblock %}
