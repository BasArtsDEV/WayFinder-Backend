{{ form_start(form, {attr: {id: 'teamForm', class: 'needs-validation'}}) }}

<div class="form-container">
    <div class="mb-4">
        {{ form_label(form.name, null, {label_attr: {class: 'form-label fw-semibold text-dark fs-6'}}) }}
        {{ form_widget(form.name) }}
        {{ form_errors(form.name) }}
    </div>

    <div class="mb-4">
        <label class="form-label fw-semibold text-dark fs-6">Bannière de l'équipe</label>

        <div class="dropzone-card">
            <div class="dropzone-area" id="dropzoneArea">
                {{ form_widget(form.bannerFile, {
                    attr: {
                        class: 'dropzone-input',
                        id: 'bannerFileInput',
                        accept: 'image/png, image/jpeg, image/webp',
                        required: 'required',
                    },
                }) }}

                <div class="dropzone-content default-content">
                    <div class="dropzone-icon">
                        <i class="bi bi-cloud-arrow-up"></i>
                    </div>
                    <div class="dropzone-text">
                        <span class="fw-bold fs-6 d-block text-white mb-1">Cliquer ou glisser une image ici</span>
                        <small class="text-muted">Formats supportés : JPG, PNG, WEBP</small>
                    </div>
                </div>

                <div class="dropzone-content selected-content">
                    <div class="dropzone-icon success-icon">
                        <i class="bi bi-check-lg"></i>
                    </div>
                    <div class="dropzone-text">
                        <span class="fw-bold fs-6 d-block text-success mb-1">Fichier prêt à être envoyé !</span>
                        <small class="text-muted">Cliquez pour remplacer le fichier</small>
                    </div>
                </div>
            </div>
        </div>
        {{ form_errors(form.bannerFile) }}
    </div>

    <button type="submit" class="btn btn-success-custom w-100 py-3 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2 mt-4">
        <i class="bi bi-check-circle-fill"></i>
        <span>{{ submit_label|default('Enregistrer l\'équipe') }}</span>
    </button>
</div>

{{ form_end(form) }}

<style>
    .form-container {
        max-width: 1000px;
        width: 100%;
        margin: 0 auto;
    }

    .custom-input {
        border-radius: 10px;
        border: 1px solid #d1d5db;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .custom-input:focus {
        border-color: var(--brand-primary, #2d6a4f);
        box-shadow: 0 0 0 3px rgba(45, 106, 79, 0.15);
    }

    .dropzone-card {
        background-color: #0b1329;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        padding: 1.25rem;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
    }

    .dropzone-area {
        position: relative;
        border: 2px dashed #1e293b;
        border-radius: 10px;
        padding: 2.5rem 1.5rem;
        text-align: center;
        background-color: rgba(15, 23, 42, 0.5);
        transition: all 0.25s ease-in-out;
        cursor: pointer;
    }

    .dropzone-input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
        z-index: 5;
    }

    .dropzone-icon {
        width: 52px;
        height: 52px;
        background-color: rgba(255, 255, 255, 0.05);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        color: #f8fafc;
        font-size: 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.25s ease-in-out;
    }

    .selected-content {
        display: none;
    }

    .dropzone-area:hover {
        border-color: #10b981;
        background-color: rgba(16, 185, 129, 0.05);
    }

    .dropzone-input:valid ~ .default-content {
        display: none !important;
    }

    .dropzone-input:valid ~ .selected-content {
        display: block !important;
    }

    .dropzone-area:has(.dropzone-input:valid) {
        border-style: solid;
        border-color: #10b981;
        background-color: rgba(16, 185, 129, 0.1);
        box-shadow: 0 0 15px rgba(16, 185, 129, 0.2);
    }

    .success-icon {
        background-color: #10b981;
        color: #ffffff;
        border-color: #10b981;
    }

    .btn-success-custom {
        background-color: var(--brand-primary, #2d6a4f);
        color: white;
        border: none;
        transition: all 0.2s;
    }

    .btn-success-custom:hover {
        background-color: var(--brand-primary-hover, #1b4332);
        color: white;
        transform: translateY(-1px);
    }
</style>
