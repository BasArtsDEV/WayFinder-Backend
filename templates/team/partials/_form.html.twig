{% block stylesheets %}
    <link href="{{ asset('styles/team/form.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

<div class="form-wrapper-center">
    <div class="team-form-card">
        <header class="team-form-card-header">
            <h1 class="team-form-card-title">{{ form_title|default('Créer une équipe') }}</h1>
            {% if form_subtitle|default(null) %}
                <p class="team-form-card-subtitle">{{ form_subtitle }}</p>
            {% endif %}
        </header>

        <div class="team-form-card-body">
            {{ form_start(form, { attr: { id: 'teamForm', class: 'needs-validation w-100' } }) }}

            <div class="mb-4">
                {{ form_label(form.name, null, { label_attr: { class: 'form-label fw-semibold text-dark fs-6' } }) }}
                {{ form_widget(form.name) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold text-dark fs-6">Bannière de l'équipe</label>

                <div class="dropzone-card">
                    <div class="dropzone-area" id="dropzoneArea">
                        {{ form_widget(form.bannerFile, {
                            attr: {
                                class: 'dropzone-input',
                                id: 'bannerFileInput',
                                accept: 'image/png, image/jpeg, image/webp',
                            },
                        }) }}

                        <div class="dropzone-prompt" id="dropzonePrompt">
                            <i class="bi bi-cloud-arrow-up fs-2 mb-2"></i>
                            <div class="dropzone-text" id="dropzoneText">
                                <span>Veuillez uploader une image valide (JPG, PNG, WEBP)</span>
                                <small>Taille maximale : 5 MO</small>
                            </div>
                        </div>
                    </div>
                </div>
                {{ form_errors(form.bannerFile) }}
            </div>

            <button type="submit" class="btn-app-primary" style="margin-right: auto; margin-left: auto">
                <i class="bi bi-check-circle-fill"></i>
                <span>{{ submit_label|default('Enregistrer l\'équipe') }}</span>
            </button>

            {{ form_end(form) }}
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const fileInput = document.querySelector('.dropzone-input');
        const textElement = document.getElementById('dropzoneText');
        const promptElement = document.getElementById('dropzonePrompt');

        if (fileInput) {
            fileInput.addEventListener('change', function(e) {
                if (e.target.files && e.target.files.length > 0) {
                    const fileName = e.target.files[0].name;
                    textElement.textContent = "Fichier sélectionné : " + fileName;
                    promptElement.classList.add('file-selected');
                } else {
                    textElement.textContent = "Veuillez uploader une image valide (JPG, PNG, WEBP), max 5 Mo";
                    promptElement.classList.remove('file-selected');
                }
            });
        }
    });
</script>
