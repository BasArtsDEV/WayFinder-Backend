{% extends 'base.html.twig' %}

{% block title %}Équipe : {{ team.name }}{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('styles/team/show.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block main %}
    <div class="team-profile-page">
        {% embed '_banner.html.twig' with {banner: team.banner} %}
            {% block overlay %}
                <h1 class="fw-bold text-white display-5 mb-0 text-shadow">{{ team.name }}</h1>
            {% endblock %}
        {% endembed %}

        <div class="container team-content-wrapper pb-5">

            {% if is_granted('ROLE_ADMIN') or (app.user and team.leader and app.user.id == team.leader.id) %}
                <div class="d-flex justify-content-end gap-2 mb-4">
                    <a href="{{ path('app_team_edit', {id: team.id}) }}" class="btn btn-light border shadow-sm rounded-pill px-3 py-2 fw-medium text-dark">
                        <i class="bi bi-pencil-square me-1 text-success"></i> Modifier l'équipe
                    </a>
                    {{ include('_delete_button.html.twig', {
                        action_path: path('app_team_delete', {id: team.id}),
                        csrf_token_name: 'delete' ~ team.id,
                        confirm_message: 'Es-tu sûr de vouloir supprimer cette équipe ?',
                    }) }}
                </div>
            {% endif %}

            <div class="row g-4">

                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 theme-card-bg">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h3 class="fw-bold fs-4 text-dark m-0">Chasses au trésor</h3>

                            <div class="view-switchers">
                                <button type="button" class="view-btn active" data-view="grid" title="Vue grille"><i class="bi bi-grid-fill"></i></button>
                                <button type="button" class="view-btn" data-view="list" title="Vue liste"><i class="bi bi-list-ul"></i></button>
                            </div>
                        </div>

                        {% set treasurehunts = team.treasurehunts %}

                        {% if treasurehunts|length > 0 %}
                            <div id="treasureContainer" class="treasure-grid">
                                {% for treasureHunt in treasurehunts %}
                                    <a href="{{ path('app_treasure_hunt_show', {id: treasureHunt.id}) }}" class="treasure-card text-decoration-none">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h4 class="fw-bold fs-5 text-dark mb-0 text-truncate">{{ treasureHunt.title }}</h4>
                                            <span class="status-badge {% if treasureHunt.published %}published{% else %}draft{% endif %}">
                                                {{ treasureHunt.published ? 'Publiée' : 'Edition' }}
                                            </span>
                                        </div>
                                        <p class="text-muted small mb-3 text-truncate-2">{{ treasureHunt.description }}</p>

                                        <div class="treasure-feedback-section d-flex align-items-center justify-content-between pt-2 border-top border-light">
                                            {% set avgstars = treasureHunt.getAverageStars() ?? 0 %}
                                            {% set feedbacks = treasureHunt.getFeedbacks() %}

                                            <div class="rating-container">
                                                <span class="fw-bold text-dark small">{{ avgstars }}</span>
                                                <div class="star-rating" title="{{ avgstars }} / 5">
                                                    {% for i in 1..5 %}
                                                        {% set fillPercentage = (avgstars - i + 1) * 100 %}
                                                        {% if fillPercentage < 0 %}{% set fillPercentage = 0 %}
                                                        {% elseif fillPercentage > 100 %}{% set fillPercentage = 100 %}{% endif %}

                                                        {% set gradId = 'star-grad-' ~ treasureHunt.id ~ '-' ~ i %}

                                                        <svg class="star-single" viewBox="0 0 24 24">
                                                            <defs>
                                                                <linearGradient id="{{ gradId }}" x1="0%" y1="0%" x2="100%" y2="0%">
                                                                    <stop offset="{{ fillPercentage }}%" stop-color="#ffc107" />
                                                                    <stop offset="{{ fillPercentage }}%" stop-color="#e4e5e9" />
                                                                </linearGradient>
                                                            </defs>
                                                            <path fill="url(#{{ gradId }})" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                                                        </svg>
                                                    {% endfor %}
                                                </div>
                                            </div>

                                            <span class="rating-number text-primary fw-medium small">
                                                {{ feedbacks|length }} avis <i class="bi bi-arrow-right-short"></i>
                                            </span>
                                        </div>
                                    </a>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-folder2-open display-4 text-secondary opacity-50 mb-2"></i>
                                <p class="mb-0">Cette équipe n'a pas encore créé de chasses au trésor.</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                        <h3 class="fw-bold fs-5 text-dark mb-2 d-flex align-items-center gap-2">
                            <i class="bi bi-people-fill text-success"></i> Membres
                        </h3>

                        {% set maxMembers = constant('App\\Entity\\Team::MAX_USERS') %}
                        {% set currentCount = team.users|length %}
                        {% set percentage = (currentCount / maxMembers) * 100 %}
                        {% if percentage > 100 %}{% set percentage = 100 %}{% endif %}

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <small class="fw-bold text-success">{{ currentCount }} / {{ maxMembers }}</small>
                            </div>
                            <div class="progress" style="height: 8px; background-color: #e9ecef; border-radius: 4px;">
                                <div class="progress-bar bg-success rounded-pill" role="progressbar" style="width: {{ percentage }}%; transition: width 0.6s ease;" aria-valuenow="{{ currentCount }}" aria-valuemin="0" aria-valuemax="{{ maxMembers }}"></div>
                            </div>
                        </div>

                        <div class="member-list d-flex flex-column gap-2">
                            {% if team.leader %}
                                <div class="member-item leader-card d-flex align-items-center justify-content-between p-3 rounded-3 bg-light border border-success border-opacity-25">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 34px; height: 34px; font-size: 0.9rem;">
                                            {{ team.leader.username|first|upper }}
                                        </div>
                                        <span class="fw-bold text-dark">@{{ team.leader.username }}</span>
                                    </div>
                                    <span class="badge bg-warning text-dark fw-semibold px-2.5 py-1 rounded-pill" title="Chef d'équipe">
                                        Chef
                                    </span>
                                </div>
                                <hr class="text-muted opacity-25 my-2">
                            {% endif %}

                            {% for user in team.users %}
                                {% if team.leader is null or user.id != team.leader.id %}
                                    <div class="member-item d-flex align-items-center justify-content-between p-2 px-3 rounded-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold opacity-75" style="width: 34px; height: 34px; font-size: 0.9rem;">
                                                {{ user.username|first|upper }}
                                            </div>
                                            <span class="text-secondary fw-medium">@{{ user.username }}</span>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}

                            {% if team.users|length == 0 and not team.leader %}
                                <p class="text-muted small fst-italic text-center my-4">Aucun membre dans cette équipe pour le moment.</p>
                            {% endif %}
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const viewButtons = document.querySelectorAll('.view-btn');
            const treasureContainer = document.getElementById('treasureContainer');

            if (viewButtons && treasureContainer) {
                viewButtons.forEach(button => {
                    button.addEventListener('click', function () {
                        viewButtons.forEach(btn => btn.classList.remove('active'));
                        this.classList.add('active');

                        const viewType = this.getAttribute('data-view');
                        if (viewType === 'list') {
                            treasureContainer.classList.add('list-view');
                        } else {
                            treasureContainer.classList.remove('list-view');
                        }
                    });
                });
            }
        });
    </script>
{% endblock %}
