{% extends 'base.html.twig' %}

{% block title %}{{ team.name|raw }}{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('styles/team/show.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block main %}
    <div class="team-profile-page">
        {% embed '_banner.html.twig' with { banner: team.banner } %}
            {% block overlay %}
                <h1 class="fw-bold text-white display-5 mb-0 text-shadow">{{ team.name }}</h1>
            {% endblock %}
        {% endembed %}

        <div class="container team-content-wrapper pb-5">
            <div class="d-flex justify-content-end gap-2 mb-4">
                {% if app.user %}
                    {% if isLeader %}
                        <a href="{{ path('app_team_invite', { id: team.id }) }}" class="btn-app-primary">
                            <i class="bi bi-person-plus-fill me-1"></i>Inviter un membre
                        </a>

                        <a href="{{ path('app_team_edit', { id: team.id }) }}" class="btn-app-secondary">
                            <i class="bi bi-pencil-square me-1"></i>Modifier
                        </a>

                        {{ include('_delete_button.html.twig', {
                            action_path: path('app_team_delete', { id: team.id }),
                            csrf_token_name: 'delete' ~ team.id,
                            confirm_message: 'En tant que chef, souhaitez-vous vraiment supprimer cette équipe ? Cette action est irréversible.',
                        }) }}

                    {% elseif isMember %}
                        <form action="{{ path('app_team_leave', { id: team.id }) }}" method="POST" onsubmit="return confirm('Es-tu sûr de vouloir quitter cette équipe ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('leave' ~ team.id) }}">
                            <button type="submit" class="btn btn-app-danger">
                                <i class="bi bi-person-dash-fill me-1"></i>Quitter
                            </button>
                        </form>

                    {% elseif hasPendingRequest %}
                        <button type="button" class="btn-app-secondary" disabled>
                            <i class="bi bi-hourglass-split me-1"></i>Demande en attente
                        </button>

                    {% else %}
                        <a class="btn-app-primary" href="{{ path('app_team_request_join', { id: team.id }) }}">
                            <i class="bi bi-person-plus-fill me-1"></i>Rejoindre
                        </a>
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') and not isLeader %}
                        <a href="{{ path('app_team_edit', { id: team.id }) }}" class="btn-app-secondary">
                            <i class="bi bi-pencil-square me-1"></i>Modifier
                        </a>

                        {{ include('_delete_button.html.twig', {
                            action_path: path('app_team_delete', { id: team.id }),
                            csrf_token_name: 'delete' ~ team.id,
                            confirm_message: 'Es-tu sûr de vouloir supprimer cette équipe ?',
                        }) }}
                    {% endif %}
                {% endif %}
            </div>

            <div class="row g-4">

                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 theme-card-bg">
                        {{ include('treasure_hunt/partials/_treasure_hunts_display.html.twig', {
                            listTitle: 'Chasses au trésor',
                            treasureHunts: treasurehunts,
                            emptyMessage: "Cette équipe n'a pas encore créé de chasses au trésor.",
                        }) }}
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                        <h3 class="fw-bold fs-5 text-dark mb-2 d-flex align-items-center gap-2">
                            <i class="bi bi-people-fill text-success"></i> Membres
                        </h3>

                        {% set maxMembers = constant('App\\Entity\\Team::MAX_USERS') %}
                        {% set currentCount = team.users|length %}
                        {% set percentage = (currentCount / maxMembers) * 100 %}
                        {% if percentage > 100 %}{% set percentage = 100 %}{% endif %}

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <small class="fw-bold text-success">{{ currentCount }} / {{ maxMembers }}</small>
                            </div>
                            <div class="progress" style="height: 8px; background-color: #e9ecef; border-radius: 4px;">
                                <div class="progress-bar bg-success rounded-pill" role="progressbar" style="width: {{ percentage }}%; transition: width 0.6s ease;" aria-valuenow="{{ currentCount }}" aria-valuemin="0" aria-valuemax="{{ maxMembers }}"></div>
                            </div>
                        </div>

                        <div class="member-list d-flex flex-column gap-2">
                            {% if team.leader %}
                                <div class="member-item leader-card d-flex align-items-center justify-content-between p-3 rounded-3 bg-light border border-success border-opacity-25">
                                    <div class="d-flex align-items-center gap-2">
                                        {{ include('profile/partials/_avatar.html.twig', {
                                            user: team.leader,
                                            size: 38,
                                        }) }}
                                        <span class="fw-bold text-dark">@{{ team.leader.username }}</span>
                                    </div>
                                    <span class="badge bg-warning text-dark fw-semibold px-2.5 py-1 rounded-pill" title="Chef d'équipe">
                                        Chef
                                    </span>
                                </div>
                                <hr class="text-muted opacity-25 my-2">
                            {% endif %}

                            {% for user in team.users %}
                                {% if team.leader is null or user.id != team.leader.id %}
                                    <div class="member-item d-flex align-items-center justify-content-between p-2 px-3 rounded-3 {% if app.user and user.id == app.user.id %}bg-opacity-10 border border-dark border-opacity-50{% endif %}">
                                        <div class="d-flex align-items-center gap-2">
                                            {{ include('profile/partials/_avatar.html.twig', {
                                                user: user,
                                                size: 38,
                                            }) }}
                                            <span class="text-secondary fw-medium">@{{ user.username }}</span>
                                        </div>
                                        {% if app.user and user.id == app.user.id %}
                                            <span class="badge bg-dark text-white fw-semibold px-2.5 py-1 rounded-pill">Moi</span>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            {% endfor %}

                            {% if team.users|length == 0 and not team.leader %}
                                <p class="text-muted small fst-italic text-center my-4">Aucun membre dans cette équipe pour le moment.</p>
                            {% endif %}
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

{% endblock %}
