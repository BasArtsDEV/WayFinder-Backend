{% extends 'base.html.twig' %}

{% set loginTitle = 'Connexion' %}

{% block title %}{{ loginTitle }}{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('styles/security/login.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block main %}
    <div class="login-page-wrapper">
        <div class="login-card">
            <div class="user-avatar-badge">
                <i class="bi bi-person-fill"></i>
            </div>

            <h1 class="login-title">{{ loginTitle }}</h1>

            {% if error %}
                <div class="alert alert-danger mx-3 my-2 text-center py-2 fs-7">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="login-form">
                <div class="form-group mb-3">
                    <label for="username" class="form-label-custom">Adresse e-mail</label>
                    <div class="input-badge-group">
                    <span class="input-badge-icon">
                        <i class="bi bi-person-fill"></i>
                    </span>
                        <input type="email" placeholder="example@gmail.com" value="{{ last_username }}" name="_username" id="username" class="form-control-custom" autocomplete="email" required autofocus>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label for="password" class="form-label-custom">Mot de passe</label>
                    <div class="input-badge-group">
                    <span class="input-badge-icon">
                        <i class="bi bi-lock-fill"></i>
                    </span>
                        <input type="password" placeholder="Entrez votre mot de passe" name="_password" id="password" class="form-control-custom" autocomplete="current-password" required>
                    </div>
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4 fs-7">
                    <label class="d-flex align-items-center gap-2 custom-checkbox cursor-pointer">
                        <input type="checkbox" name="_remember_me" class="form-check-input mt-0">
                        <span>Se souvenir de moi</span>
                    </label>
                    <a href="#" class="text-decoration-none text-dark fw-semibold hover-green">Mot de passe oublié ?</a>
                </div>

                <button class="btn btn-login-submit" type="submit">
                    CONNEXION
                </button>

                <div class="text-center mt-3">
                    <a href="{{ path('app_register') }}" class="text-decoration-none text-secondary small hover-green">
                        Pas encore de compte ? <strong class="text-success">Créer un compte</strong>
                    </a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
