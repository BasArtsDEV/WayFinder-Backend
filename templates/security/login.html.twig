{% extends 'base.html.twig' %}

{% set loginTitle = 'Connexion' %}

{% block title %}{{ loginTitle }}{% endblock %}

{% block main %}
    <div class="login-page-wrapper">
        <div class="login-card">
            <div class="user-avatar-badge">
                <i class="bi bi-person-fill"></i>
            </div>

            <h1 class="login-title">{{ loginTitle }}</h1>

            {% if error %}
                <div class="alert alert-danger mx-3 my-2 text-center py-2 fs-7">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="login-form">
                <div class="form-group mb-3">
                    <label for="username" class="form-label-custom">Adresse e-mail</label>
                    <div class="input-badge-group">
                    <span class="input-badge-icon">
                        <i class="bi bi-person-fill"></i>
                    </span>
                        <input type="email" placeholder="example@gmail.com" value="{{ last_username }}" name="_username" id="username" class="form-control-custom" autocomplete="email" required autofocus>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label for="password" class="form-label-custom">Mot de passe</label>
                    <div class="input-badge-group">
                    <span class="input-badge-icon">
                        <i class="bi bi-lock-fill"></i>
                    </span>
                        <input type="password" placeholder="Entrez votre mot de passe" name="_password" id="password" class="form-control-custom" autocomplete="current-password" required>
                    </div>
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4 fs-7">
                    <label class="d-flex align-items-center gap-2 custom-checkbox cursor-pointer">
                        <input type="checkbox" name="_remember_me" class="form-check-input mt-0">
                        <span>Se souvenir de moi</span>
                    </label>
                    <a href="#" class="text-decoration-none text-dark fw-semibold hover-green">Mot de passe oublié ?</a>
                </div>

                <button class="btn btn-login-submit" type="submit">
                    CONNEXION
                </button>

                <div class="text-center mt-3">
                    <a href="{{ path('app_register') }}" class="text-decoration-none text-secondary small hover-green">
                        Pas encore de compte ? <strong class="text-success">Créer un compte</strong>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <style>
        .login-page-wrapper {
            width: 100%;
            flex-grow: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 3rem 1rem;
        }

        .login-card {
            position: relative;
            width: 100%;
            max-width: 420px;
            background-color: #ffffff;
            border-radius: 28px;
            padding: 4.5rem 2.25rem 4.5rem 2.25rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
            overflow: hidden;
        }

        .login-card::before,
        .login-card::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            height: 80px;
            z-index: 1;
            pointer-events: none;
        }

        .login-card::before {
            top: 0;
            background: linear-gradient(135deg, #2e7d32 0%, #388e3c 50%, #43a047 100%);
            clip-path: polygon(0 0, 100% 0, 100% 65%, 78% 35%, 50% 60%, 22% 35%, 0 65%);
        }

        .login-card::after {
            bottom: 0;
            background: linear-gradient(45deg, #2e7d32 0%, #388e3c 50%, #43a047 100%);
            clip-path: polygon(0 35%, 22% 65%, 50% 40%, 78% 65%, 100% 35%, 100% 100%, 0 100%);
        }

        .user-avatar-badge {
            position: absolute;
            top: 18px;
            left: 50%;
            transform: translateX(-50%);
            width: 72px;
            height: 72px;
            background-color: #2c2c2c;
            border: 4px solid #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 2.2rem;
            z-index: 2;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        }

        .login-title {
            position: relative;
            z-index: 2;
            text-align: center;
            font-size: 1.65rem;
            font-weight: 800;
            color: #2e7d32;
            margin-top: 0.5rem;
            margin-bottom: 2rem;
            letter-spacing: 0.05em;
        }

        .login-form {
            position: relative;
            z-index: 2;
        }

        .form-label-custom {
            display: block;
            font-size: 0.88rem;
            font-weight: 700;
            color: #2c2c2c;
            margin-bottom: 0.35rem;
        }

        .input-badge-group {
            display: flex;
            align-items: center;
            background-color: #e2e8f0;
            border-radius: 12px;
            overflow: hidden;
            height: 48px;
        }

        .input-badge-icon {
            width: 48px;
            height: 100%;
            background-color: #2e7d32;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .form-control-custom {
            flex-grow: 1;
            height: 100%;
            border: none;
            background: transparent;
            padding: 0 1rem;
            font-size: 0.92rem;
            color: #2d3748;
            outline: none;
        }

        .form-control-custom::placeholder {
            color: #a0aec0;
        }

        .btn-login-submit {
            width: 100%;
            height: 48px;
            background-color: #2e7d32;
            color: #ffffff;
            border: none;
            border-radius: 24px;
            font-weight: 800;
            font-size: 1.05rem;
            letter-spacing: 0.05em;
            transition: all 0.2s ease-in-out;
            box-shadow: 0 4px 12px rgba(46, 125, 50, 0.25);
        }

        .btn-login-submit:hover {
            background-color: #256628;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(46, 125, 50, 0.35);
        }

        .hover-green:hover {
            color: #2e7d32 !important;
        }
    </style>
{% endblock %}
