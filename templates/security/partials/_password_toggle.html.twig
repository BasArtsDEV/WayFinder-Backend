<button type="button"
        class="password-toggle-btn"
        data-password-toggle-target="button"
        data-action="password-toggle#toggle"
        data-password-toggle-show-label-value="{{ 'common.password_show'|trans }}"
        data-password-toggle-hide-label-value="{{ 'common.password_hide'|trans }}"
        aria-label="{{ 'common.password_show'|trans }}"
        aria-pressed="false">
    <i class="bi bi-eye" data-password-toggle-target="icon"></i>
</button>
