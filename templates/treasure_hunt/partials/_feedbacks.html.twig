{% set feedbacksList = feedbacks ?? treasureHunt.getFeedbacks() %}
{% if feedbacksList|length > 0 %}
    <div class="feedbacks-section">
        <div class="mb-3">
            <button class="feedbacks-toggle d-flex align-items-center gap-2"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#feedbacks-collapse"
                    aria-expanded="false"
                    aria-controls="feedbacks-collapse">
                <h3 class="h4 fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    {{ feedbacksList|length }} avis
                </h3>
                <span class="feedbacks-arrow-wrapper">
                    <i class="bi bi-chevron-down feedbacks-arrow" aria-hidden="true"></i>
                </span>
            </button>
        </div>

        <div class="collapse" id="feedbacks-collapse">
            <div class="row g-3">
                {% for feedback in feedbacksList %}
                    <div class="col-md-6 col-lg-4">
                        <div class="feedback-card h-100">
                            <div class="d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div class="d-flex align-items-center gap-2">
                                            {% if feedback.user %}
                                                {{ include('profile/partials/_avatar.html.twig', {
                                                    user: feedback.user,
                                                    size: 38,
                                                }) }}
                                            {% endif %}
                                            <div>
                                                <h4 class="h6 fw-bold text-dark mb-0">{{ feedback.user.username ?? 'Joueur anonyme' }}</h4>
                                            </div>
                                        </div>

                                        {% set rating = feedback.stars ?? feedback.nbStars ?? 0 %}
                                        <div class="d-flex align-items-center">
                                            {% for i in 1..5 %}
                                                {% set fillPercentage = (rating - i + 1) * 100 %}
                                                {% if fillPercentage < 0 %}{% set fillPercentage = 0 %}{% endif %}
                                                {% if fillPercentage > 100 %}{% set fillPercentage = 100 %}{% endif %}

                                                {% set gradId = 'star-fb-' ~ loop.parent.loop.index ~ '-' ~ i %}

                                                <svg class="star-single" viewBox="0 0 24 24" aria-hidden="true">
                                                    <defs>
                                                        <linearGradient id="{{ gradId }}" x1="0%" y1="0%" x2="100%" y2="0%">
                                                            <stop offset="{{ fillPercentage }}%" stop-color="#ffc107"></stop>
                                                            <stop offset="{{ fillPercentage }}%" stop-color="#e4e5e9"></stop>
                                                        </linearGradient>
                                                    </defs>
                                                    <path fill="url(#{{ gradId }})" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
                                                </svg>
                                            {% endfor %}
                                        </div>
                                    </div>

                                    <p class="text-secondary small mb-0" style="line-height: 1.5;">
                                        {{ feedback.feedback }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endif %}
