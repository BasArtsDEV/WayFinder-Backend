{% set feedbacksList = feedbacks ?? treasureHunt.getFeedbacks() %}
{% if feedbacksList|length > 0 %}
    <style>
        .feedbacks-toggle {
            background: none;
            border: 0;
            padding: 0;
            color: inherit;
            text-align: left;
        }
        .feedbacks-toggle:focus-visible {
            outline: 2px solid;
            outline-offset: 4px;
            border-radius: .5rem;
        }
        .feedbacks-toggle .feedbacks-arrow {
            transition: transform .25s ease;
        }
        .feedbacks-toggle[aria-expanded="true"] .feedbacks-arrow {
            transform: rotate(180deg);
        }
        @media (prefers-reduced-motion: reduce) {
            .feedbacks-toggle .feedbacks-arrow { transition: none; }
        }
    </style>

    <div class="mt-5">
        <div class="mb-3">
            <button class="feedbacks-toggle d-flex align-items-center gap-2"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#feedbacks-collapse"
                    aria-expanded="false"
                    aria-controls="feedbacks-collapse">
                <h3 class="h4 fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    {{ feedbacksList|length }} avis
                </h3>
                <span class="d-inline-flex align-items-center justify-content-center bg-white border rounded-circle shadow-sm flex-shrink-0"
                      style="width: 32px; height: 32px;">
                    <i class="bi bi-chevron-down feedbacks-arrow"></i>
                </span>
            </button>
        </div>

        <div class="collapse" id="feedbacks-collapse">
            <div class="row g-3">
                {% for feedback in feedbacksList %}
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3">
                            <div class="card-body p-2 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div class="d-flex align-items-center gap-2">
                                            {% if feedback.user %}
                                                {{ include('profile/partials/_avatar.html.twig', {
                                                    user: feedback.user,
                                                    size: 38,
                                                }) }}
                                            {% endif %}
                                            <div>
                                                <h4 class="h6 fw-bold text-dark mb-0">{{ feedback.user.username ?? 'Joueur anonyme' }}</h4>
                                            </div>
                                        </div>

                                        {% set rating = feedback.stars ?? feedback.nbStars ?? 0 %}
                                        <div class="d-flex align-items-center">
                                            {% for i in 1..5 %}
                                                {% set fillPercentage = (rating - i + 1) * 100 %}
                                                {% if fillPercentage < 0 %}{% set fillPercentage = 0 %}{% endif %}
                                                {% if fillPercentage > 100 %}{% set fillPercentage = 100 %}{% endif %}

                                                {% set gradId = 'star-fb-' ~ loop.parent.loop.index ~ '-' ~ i %}

                                                <svg class="star-single" viewBox="0 0 24 24" style="width: 16px; height: 16px;">
                                                    <defs>
                                                        <linearGradient id="{{ gradId }}" x1="0%" y1="0%" x2="100%" y2="0%">
                                                            <stop offset="{{ fillPercentage }}%" stop-color="#ffc107"></stop>
                                                            <stop offset="{{ fillPercentage }}%" stop-color="#e4e5e9"></stop>
                                                        </linearGradient>
                                                    </defs>
                                                    <path fill="url(#{{ gradId }})" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
                                                </svg>
                                            {% endfor %}
                                        </div>
                                    </div>

                                    <p class="text-secondary small mb-0" style="line-height: 1.5;">
                                        {{ feedback.feedback }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endif %}
