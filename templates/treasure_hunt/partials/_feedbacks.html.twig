<section id="avis" class="mt-5" aria-labelledby="avis-title">
    <h2 id="avis-title" class="h4 fw-bold text-dark mb-3">
        Avis des participants <span class="text-muted">({{ feedbacks.totalItemCount }})</span>
    </h2>

    <div class="d-flex flex-column gap-3 mb-4">
        {% for enrollment in feedbacks %}
            <article class="card border-0 rounded-3">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
                        <h3 class="h6 fw-bold mb-0">{{ enrollment.user.username }}</h3>
                        {% if enrollment.nbStars is not null %}
                            <span class="text-muted" aria-label="Note : {{ enrollment.nbStars }} sur 5">
                                <i class="bi bi-star-fill text-warning" aria-hidden="true"></i>
                                {{ enrollment.nbStars }} / 5
                            </span>
                        {% endif %}
                    </div>
                    <p class="mb-0 text-break">{{ enrollment.feedback }}</p>
                </div>
            </article>
        {% else %}
            <p class="text-muted mb-0">Aucun avis pour le moment.</p>
        {% endfor %}
    </div>

    {{ knp_pagination_render(feedbacks, null, {_fragment: 'avis'}) }}
</section>
