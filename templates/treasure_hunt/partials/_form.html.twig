<style>
    .form-wrapper-center {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 0 1rem;
    }

    .form-container {
        width: 100%;
        max-width: 1000px;
    }

    .text-slate {
        color: #0f172a;
    }

    .fs-7 {
        font-size: 0.875rem;
    }

    .custom-input {
        border-color: #cbd5e1;
        color: #0f172a;
    }

    .custom-input:focus {
        border-color: #0f172a;
        box-shadow: 0 0 0 2px rgba(15, 23, 42, 0.1);
    }

    .form-container ul {
        list-style: none;
        padding-left: 0;
        margin-top: 0.5rem;
        margin-bottom: 0;
    }

    .form-container ul li {
        color: #dc3545;
        font-size: 0.8125rem;
    }
</style>

<div class="form-wrapper-center">
    {{ form_start(form, { attr: { id: 'customForm', class: 'needs-validation w-100 my-auto d-flex justify-content-center' } }) }}

    <div class="form-container bg-white rounded-4 shadow-sm p-4 p-md-5">
        <div class="mb-4">
            {{ form_label(form.title, null, { label_attr: { class: 'form-label fw-semibold text-slate fs-7 mb-2' } }) }}
            {{ form_widget(form.title, { attr: { class: 'form-control custom-input py-2 px-3 fs-7' } }) }}
            {{ form_errors(form.title) }}
        </div>

        <div class="mb-4">
            {{ form_label(form.description, null, { label_attr: { class: 'form-label fw-semibold text-slate fs-7 mb-2' } }) }}
            {{ form_widget(form.description, { attr: { class: 'form-control custom-input py-2 px-3 fs-7', rows: 4 } }) }}
            {{ form_errors(form.description) }}
        </div>

        <div class="mb-4">
            {{ form_label(form.team, null, { label_attr: { class: 'form-label fw-semibold text-slate fs-7 mb-2' } }) }}
            {{ form_widget(form.team, { attr: { class: 'form-control custom-input py-2 px-3 fs-7' } }) }}
            {{ form_errors(form.team) }}
        </div>

        <div class="mb-4">
            {{ form_label(form.duration, null, { label_attr: { class: 'form-label fw-semibold text-slate fs-7 mb-2' } }) }}
            {{ form_widget(form.duration, { attr: { class: 'form-control custom-input py-2 px-3 fs-7' } }) }}
            {{ form_errors(form.duration) }}
        </div>

        <div class="mb-4 form-check">
            {{ form_widget(form.listed, { attr: { class: 'form-check-input' } }) }}
            {{ form_label(form.listed, null, { label_attr: { class: 'form-check-label text-slate fs-7' } }) }}
            {{ form_errors(form.listed) }}
        </div>

        <button type="submit" class="btn btn-app-primary w-100 py-2 px-4 fw-medium rounded-3 d-flex align-items-center justify-content-center gap-2 mt-4 fs-7">
            <i class="bi bi-check-circle-fill"></i>
            <span>{{ submit_label|default('Enregistrer') }}</span>
        </button>
    </div>

    {{ form_end(form) }}
</div>
