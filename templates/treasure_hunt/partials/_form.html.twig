{% block stylesheets %}
    <link href="{{ asset('styles/team/form.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

<div class="form-wrapper-center">
    {{ form_start(form, {attr: {id: 'customForm', class: 'needs-validation w-100 my-auto'}}) }}

    <div class="form-container">
        <div class="mb-4">
            {{ form_label(form.title, null, {label_attr: {class: 'form-label fw-semibold text-dark fs-6'}}) }}
            {{ form_widget(form.title, {attr: {class: 'form-control custom-input'}}) }}
            {{ form_errors(form.title) }}
        </div>

        <div class="mb-4">
            {{ form_label(form.description, null, {label_attr: {class: 'form-label fw-semibold text-dark fs-6'}}) }}
            {{ form_widget(form.description, {attr: {class: 'form-control custom-input', rows: 4}}) }}
            {{ form_errors(form.description) }}
        </div>

        <button type="submit" class="btn btn-success-custom w-100 py-3 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2 mt-4">
            <i class="bi bi-check-circle-fill"></i>
            <span>{{ submit_label|default('Enregistrer') }}</span>
        </button>
    </div>

    {{ form_end(form) }}
</div>
