<form method="post"
      action="{{ path('app_treasure_hunt_delete', {id: treasureHunt.id}) }}"
      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette chasse au trésor ?');">

    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ treasureHunt.id) }}">

    <button class="btn btn-danger btn-sm" title="Supprimer">
        <i class="bi bi-trash"></i> Supprimer
    </button>

</form>
