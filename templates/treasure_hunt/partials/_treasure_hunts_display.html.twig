{% set tabId = id|default(random()) %}

{% if listTitle is defined and listTitle %}
    <h3 class="{{ listTitleClass|default('fw-bold fs-4 text-dark mb-4') }}">{{ listTitle|raw }}</h3>
{% endif %}

{% if treasureHunts|length > 0 %}
    <div class="hunt-grid">
        {% for treasureHunt in treasureHunts %}
            {% set riddlesCount = treasureHunt.riddles|length %}
            {% set playersCount = treasureHunt.enrollments|length %}

            <a href="{{ path('app_treasure_hunt_show', { id: treasureHunt.id }) }}" class="hunt-card {{ treasureHunt.published ? 'published' }}">
                <div class="hunt-card-header">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h4 class="fw-bold fs-5 text-dark mb-0">{{ treasureHunt.title }}</h4>
                        <span class="status-badge {% if treasureHunt.published %}published{% else %}draft{% endif %} m-0">
                            {{ 'treasure_hunt.status'|trans({ published: treasureHunt.published ? 'true' : 'false' }) }}
                        </span>
                    </div>
                    <p class="text-muted small mb-2 text-truncate-2">{{ treasureHunt.description }}</p>

                <ul class="hunt-card-meta">
                    {% if showTeam|default(false) %}
                        <li><i class="bi bi-people-fill" aria-hidden="true"></i><span>{{ treasureHunt.team.name }}</span></li>
                    {% endif %}
                    <li><i class="bi bi-puzzle-fill" aria-hidden="true"></i><span>{{ riddlesCount }} énigme{{ riddlesCount > 1 ? 's' }}</span></li>
                    <li><i class="bi bi-hourglass-split" aria-hidden="true"></i><span>{{ (treasureHunt.duration / 60)|round }} min</span></li>
                    <li><i class="bi bi-person-fill" aria-hidden="true"></i><span>{{ playersCount }} joueur{{ playersCount > 1 ? 's' }}</span></li>
                </ul>

                <div class="hunt-card-footer">
                    {% set avgstars = treasureHunt.getAverageStars() ?? 0 %}
                    {% set feedbacks = treasureHunt.getFeedbacks() %}

                    <div class="rating-container">
                        <span class="fw-bold small">{{ avgstars }}</span>
                        <div class="star-rating" title="{{ avgstars }} / 5">
                            {% for i in 1..5 %}
                                {% set fillPercentage = (avgstars - i + 1) * 100 %}
                                {% if fillPercentage < 0 %}{% set fillPercentage = 0 %}
                                {% elseif fillPercentage > 100 %}{% set fillPercentage = 100 %}{% endif %}

                                {% set gradId = 'star-grad-' ~ tabId ~ '-' ~ treasureHunt.id ~ '-' ~ i %}

                                <svg class="star-single" viewBox="0 0 24 24" aria-hidden="true">
                                    <defs>
                                        <linearGradient id="{{ gradId }}" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="{{ fillPercentage }}%" stop-color="#ffc107"></stop>
                                            <stop offset="{{ fillPercentage }}%" stop-color="#e4e5e9"></stop>
                                        </linearGradient>
                                    </defs>
                                    <path fill="url(#{{ gradId }})" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
                                </svg>
                            {% endfor %}
                        </div>
                    </div>

                    <span class="hunt-card-reviews">
                        {{ 'treasure_hunt.reviews'|trans({ count: feedbacks|length }) }} <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
                    </span>
                </div>
            </a>
        {% endfor %}
    </div>
{% else %}
    <div class="hunt-empty">
        <i class="bi bi-map" aria-hidden="true"></i>
        <p class="mb-0">{{ emptyMessage|default('Aucune chasse au trésor pour le moment.') }}</p>
    </div>
{% endif %}
