{% extends 'base.html.twig' %}

{% block title %}{{ treasureHunt.title|raw }} - Détails{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/riddle/show.css') }}">
{% endblock %}

{% block main %}
    <div class="container-fluid px-2 px-md-4 py-4" style="max-width: 1600px;">

        <div class="treasure-card p-4 p-lg-5 mb-4">
            <div class="d-flex flex-column flex-lg-row align-items-lg-start justify-content-between gap-4">

                <div class="flex-grow-1 hunt-header-info">
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
                        {% if treasureHunt.published %}
                            <span class="hunt-badge published">
                                <i class="bi bi-cloud-check-fill" aria-hidden="true"></i> Publiée
                            </span>
                        {% else %}
                            <span class="hunt-badge">
                                <i class="bi bi-eye-slash-fill" aria-hidden="true"></i> Brouillon
                            </span>
                        {% endif %}

                        {% set avgstars = treasureHunt.getAverageStars() ?? 0 %}
                        <div class="hunt-badge light" title="{{ avgstars }} / 5">
                            <div class="star-rating">
                                {% for i in 1..5 %}
                                    {% if avgstars >= i %}
                                        <i class="bi bi-star-fill"></i>
                                    {% elseif avgstars >= (i - 0.5) %}
                                        <i class="bi bi-star-half"></i>
                                    {% else %}
                                        <i class="bi bi-star text-secondary"></i>
                                    {% endif %}
                                {% endfor %}
                            </div>
                            <span class="fw-bold">{{ avgstars > 0 ? avgstars|number_format(1) : 'Pas d\'avis' }}</span>
                        </div>

                    </div>

                    <h1 class="fw-bold text-dark h2 mb-2">{{ treasureHunt.title }}</h1>
                    <div class="d-flex flex-wrap align-items-center gap-2 text-muted small mb-3">
                        {{ include('profile/partials/_avatar.html.twig', { user: treasureHunt.team.leader, size: 24 }) }}
                        <span>Créé par <a href="{{ path('app_team_show', { id: treasureHunt.team.id }) }}" class="text-dark fw-semibold text-decoration-none">{{ treasureHunt.team.name }}</a></span>
                        <span aria-hidden="true">•</span>
                        <span>{{ treasureHunt.creationDate|date_formatter }}</span>
                    </div>
                    <p class="text-secondary mb-0 hunt-description">{{ treasureHunt.description }}</p>
                </div>

                <div class="hunt-header-side">
                    <div class="hunt-header-actions {{ treasureHunt.published ? 'equal-buttons' }}">
                        {% if riddles|filter(r => r is instanceof('App\\Entity\\RiddleQRCode'))|length > 0 %}
                            <a href="{{ path('app_treasure_hunt_qrcodes', { id: treasureHunt.id }) }}" class="btn btn-app-secondary" target="_blank" data-turbo="false">
                                <i class="bi bi-printer me-1"></i>Imprimer les QR Codes
                            </a>
                        {% endif %}

                        {% if treasureHunt.published %}
                            {% if is_granted('TREASURE_HUNT_RESET_SCORES', treasureHunt) %}
                                <a href="{{ path('app_treasure_hunt_leaderboard', { id: treasureHunt.id }) }}" class="btn btn-app-secondary">
                                    <i class="bi bi-trophy me-1" aria-hidden="true"></i>Classement
                                </a>
                            {% endif %}

                            <form method="post" action="{{ path('app_treasure_hunt_unpublish', { id: treasureHunt.id }) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('unpublish' ~ treasureHunt.id) }}">
                                <button type="submit" class="btn btn-app-danger">
                                    <i class="bi bi-pause-circle me-1"></i>Dépublier
                                </button>
                            </form>
                        {% else %}
                            {% if is_granted('TREASURE_HUNT_EDIT', treasureHunt) %}
                                <a href="{{ path('app_treasure_hunt_edit', { id: treasureHunt.id }) }}" class="btn btn-app-secondary">
                                    <i class="bi bi-pencil me-1"></i>Éditer
                                </a>
                            {% endif %}

                            {% if is_granted('TREASURE_HUNT_RESET_SCORES', treasureHunt) %}
                                <a href="{{ path('app_treasure_hunt_leaderboard', { id: treasureHunt.id }) }}" class="btn btn-app-secondary">
                                    <i class="bi bi-trophy me-1" aria-hidden="true"></i>Classement
                                </a>
                            {% endif %}
                        {% endif %}
                    </div>

                    {% if not treasureHunt.published %}
                        {% if is_granted('TREASURE_HUNT_DELETE', treasureHunt) %}
                            <div class="hunt-header-actions equal-buttons">
                                {{ include('_delete_button.html.twig', {
                                    action_path: path('app_treasure_hunt_delete', { id: treasureHunt.id }),
                                    csrf_token_name: 'delete' ~ treasureHunt.id,
                                    confirm_message: 'Confirmer la suppression de la chasse aux trésors ?',
                                    btn_class: 'btn btn-app-danger',
                                }) }}

                                <form method="post" action="{{ path('app_treasure_hunt_publish', { id: treasureHunt.id }) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('publish' ~ treasureHunt.id) }}">
                                    <button type="submit" class="btn btn-app-primary">
                                        <i class="bi bi-rocket-takeoff-fill me-1"></i>Publier
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    {% elseif treasureHunt.invitationCode %}
                        <div class="hunt-code">
                            <div class="hunt-code-content">
                                <span class="hunt-code-label">Code d'invitation :</span>
                                <span class="hunt-code-value">{{ treasureHunt.invitationCode }}</span>
                            </div>
                            <button type="button" class="hunt-code-copy" onclick="copyInvitationCode(this, '{{ treasureHunt.invitationCode }}')">
                                <i class="bi bi-clipboard" aria-hidden="true"></i>
                                <span>Copier</span>
                            </button>
                        </div>
                    {% endif %}
                </div>

            </div>

            {{ include('treasure_hunt/partials/_feedbacks.html.twig', ignore_missing: true) }}
        </div>

        <div class="row g-4 align-items-start">

            <div class="col-lg-4 col-xl-3">
                <div class="treasure-card p-3 riddle-sidebar">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                        <h2 class="riddle-sidebar-title">
                            {{ riddles|length }} énigme{{ riddles|length > 1 ? 's' }}
                        </h2>

                        {% if not treasureHunt.published and is_granted('RIDDLE_ADD', treasureHunt) %}
                            <div class="dropdown" data-turbo="false">
                                <button type="button" class="btn btn-app-primary btn-sm px-3" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-plus-lg me-1"></i>Ajouter
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end riddle-add-menu">
                                    <li><a class="dropdown-item" href="{{ path('app_riddle_new', { huntId: treasureHunt.id, type: 'text' }) }}"><i class="bi bi-chat-left-text me-2 text-success" aria-hidden="true"></i>Texte</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_riddle_new', { huntId: treasureHunt.id, type: 'qcm' }) }}"><i class="bi bi-ui-checks me-2 text-success" aria-hidden="true"></i>QCM</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_riddle_new', { huntId: treasureHunt.id, type: 'gps' }) }}"><i class="bi bi-geo-alt me-2 text-success" aria-hidden="true"></i>GPS</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_riddle_new', { huntId: treasureHunt.id, type: 'qrcode' }) }}"><i class="bi bi-qr-code me-2 text-success" aria-hidden="true"></i>QR Code</a></li>
                                </ul>
                            </div>
                        {% endif %}
                    </div>

                    <div class="nav nav-pills flex-column flex-nowrap" id="draggable-riddle-list" role="tablist">
                        {% for index, riddle in riddles %}
                            <div class="riddle-nav-item d-flex align-items-center gap-3 {{ loop.first ? 'active' : '' }}"
                                 id="riddle-tab-{{ riddle.id }}"
                                 data-bs-toggle="pill"
                                 data-bs-target="#riddle-pane-{{ riddle.id }}"
                                 data-riddle-id="{{ riddle.id }}"
                                 draggable="{{ not treasureHunt.published ? 'true' : 'false' }}"
                                 role="tab"
                                 aria-controls="riddle-pane-{{ riddle.id }}"
                                 aria-selected="{{ loop.first ? 'true' : 'false' }}">

                                <i class="bi bi-grip-vertical text-muted" aria-hidden="true"></i>

                                <span class="riddle-num-badge d-flex align-items-center justify-content-center flex-shrink-0">
                                    {{ riddle.index }}
                                </span>

                                <div class="riddle-label flex-grow-1 min-w-0">
                                    <div class="fw-semibold small text-dark text-break mb-1" style="line-height: 1.3;">{{ riddle.title }}</div>
                                    <div class="text-muted d-flex align-items-center gap-1" style="font-size: 0.7rem;">
                                        {% if riddle is instanceof('App\\Entity\\RiddleQCM') %}<i class="bi bi-ui-checks text-success" aria-hidden="true"></i> QCM
                                        {% elseif riddle is instanceof('App\\Entity\\RiddleGPS') %}<i class="bi bi-geo-alt text-success" aria-hidden="true"></i> GPS
                                        {% elseif riddle is instanceof('App\\Entity\\RiddleQRCode') %}<i class="bi bi-qr-code text-success" aria-hidden="true"></i> QR Code
                                        {% else %}<i class="bi bi-chat-left-text text-success" aria-hidden="true"></i> Texte{% endif %}
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="p-4 text-center text-muted small treasure-card-inner">Aucune énigme configurée.</div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="col-lg-8 col-xl-9">
                <div class="tab-content" id="riddles-tabContent">
                    {% for index, riddle in riddles %}
                        <div class="tab-pane fade {{ loop.first ? 'show active' : '' }}" id="riddle-pane-{{ riddle.id }}" role="tabpanel">
                            <div class="treasure-card text-break p-4 p-md-5">

                                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4 pb-3 border-bottom">
                                    <div class="d-flex align-items-center gap-3">
                                        <div>
                                            <h2 class="h5 fw-bold text-dark mb-0">{{ riddle.title }}</h2>
                                        </div>
                                    </div>

                                    {% if not treasureHunt.published %}
                                        <div class="d-flex align-items-center gap-2 flex-shrink-0 text-nowrap">
                                            {% if is_granted('TREASURE_HUNT_EDIT', treasureHunt) %}
                                                <a href="{{ path('app_riddle_edit', { id: riddle.id }) }}" class="btn btn-app-secondary btn-sm">
                                                    <i class="bi bi-pencil me-1"></i>Éditer
                                                </a>
                                            {% endif %}

                                            {% if is_granted('TREASURE_HUNT_DELETE', treasureHunt) %}
                                                {{ include('_delete_button.html.twig', {
                                                    action_path: path('app_riddle_delete', { id: riddle.id }),
                                                    csrf_token_name: 'delete' ~ riddle.id,
                                                    confirm_message: 'Confirmer la suppression de cette énigme ?',
                                                    btn_class: 'btn btn-app-danger btn-sm',
                                                }) }}
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>

                                {% if riddle.description %}
                                    <div class="mb-4">
                                        <label class="text-muted fw-bold text-uppercase d-block mb-1" style="font-size: 0.68rem; letter-spacing: 1px;">Indice</label>
                                        <p class="text-dark mb-0" style="line-height: 1.6;">{{ riddle.description }}</p>
                                    </div>
                                {% endif %}

                                {% if riddle.img %}
                                    <div class="mb-4 text-center treasure-card-inner p-3">
                                        <img src="data:image/png;base64,{{ riddle.imgBase64 }}"
                                             alt="{{ riddle.imgDescription ?? 'Illustration énigme' }}"
                                             class="img-fluid rounded-3" style="max-height: 320px; object-fit: contain;" />
                                    </div>
                                {% endif %}

                                {% if riddle is instanceof('App\\Entity\\RiddleQCM') %}
                                    <div class="treasure-card-inner p-4">
                                        <div class="d-flex align-items-center gap-2 mb-3">
                                            <span class="riddle-type-badge"><i class="bi bi-ui-checks" aria-hidden="true"></i> Question QCM</span>
                                        </div>
                                        <p class="fw-bold text-dark h6 mb-3">{{ riddle.question }}</p>

                                        <div class="d-flex flex-column gap-2">
                                            {% for choice in riddle.choices %}
                                                <div class="qcm-choice-box d-flex align-items-center gap-2 w-100 {{ choice.isRight ? 'is-correct' : '' }}">
                                                    <span class="qcm-choice-badge">{{ loop.index }}</span>
                                                    <span class="fw-medium text-dark small flex-grow-1">{{ choice.choice }}</span>
                                                    {% if choice.isRight %}
                                                        <i class="bi bi-check-circle-fill text-success ms-1" title="Bonne réponse"></i>
                                                    {% endif %}
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>

                                {% elseif riddle is instanceof('App\\Entity\\RiddleGPS') %}
                                    <div class="treasure-card-inner p-4">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                                            <span class="riddle-type-badge"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> Localisation GPS</span>
                                            <code class="bg-light px-3 py-1 rounded-pill text-dark font-monospace small">{{ riddle.latitude }}, {{ riddle.longitude }}</code>
                                        </div>
                                        <div class="rounded-3 overflow-hidden">
                                            {{ ux_map(map, { style: 'height: 320px; width: 100%;' }) }}
                                        </div>
                                    </div>

                                {% elseif riddle is instanceof('App\\Entity\\RiddleQRCode') %}
                                    <div class="treasure-card-inner p-4 text-center">
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="riddle-type-badge mb-3">
                                                <i class="bi bi-qr-code" aria-hidden="true"></i> Scanner un QR Code
                                            </span>

                                            <div class="my-2 p-2 bg-white rounded-3 border">
                                                <img src="{{ qr_code_url(riddle.url) }}" alt="QR code" class="img-fluid" style="width: 120px; height: 120px;"/>
                                            </div>

                                            <div class="mt-3 w-100">
                                                <label class="text-muted fw-bold text-uppercase d-block mb-1" style="font-size: 0.65rem;">Lien cible</label>
                                                <a href="{{ riddle.url }}" target="_blank" class="fw-bold text-success font-monospace text-decoration-none text-break d-inline-block">{{ riddle.url }}</a>
                                            </div>
                                        </div>
                                    </div>

                                {% elseif riddle is instanceof('App\\Entity\\RiddleText') %}
                                    <div class="treasure-card-inner p-4">
                                        <span class="riddle-type-badge mb-3"><i class="bi bi-chat-left-text-fill" aria-hidden="true"></i> Réponse libre</span>
                                        <p class="fw-bold text-dark h6 mb-3">{{ riddle.question }}</p>
                                        <div class="p-3 bg-light rounded-3">
                                            <span class="small">Réponse attendue : <strong>{{ riddle.expectedAnswer }}</strong></span>
                                        </div>
                                    </div>
                                {% endif %}

                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>

    <script>
        function copyInvitationCode(button, code) {
            navigator.clipboard.writeText(code).then(() => {
                const icon = button.querySelector('i');
                const text = button.querySelector('span');
                icon.className = 'bi bi-check-lg';
                text.textContent = 'Copié !';

                setTimeout(() => {
                    icon.className = 'bi bi-clipboard';
                    text.textContent = 'Copier';
                }, 2000);
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('draggable-riddle-list');
            if (!container) return;

            let draggedItem = null;

            container.addEventListener('dragstart', (e) => {
                const target = e.target.closest('.riddle-nav-item');
                if (!target) return;
                draggedItem = target;
                target.classList.add('dragging');
                e.dataTransfer.effectAllowed = 'move';
            });

            container.addEventListener('dragend', (e) => {
                const target = e.target.closest('.riddle-nav-item');
                if (!target) return;
                target.classList.remove('dragging');
                draggedItem = null;
                updateRiddleIndexes();
            });

            container.addEventListener('dragover', (e) => {
                e.preventDefault();
                const afterElement = getDragAfterElement(container, e.clientY);
                if (afterElement == null) {
                    container.appendChild(draggedItem);
                } else {
                    container.insertBefore(draggedItem, afterElement);
                }
            });

            function getDragAfterElement(container, y) {
                const draggableElements = [...container.querySelectorAll('.riddle-nav-item:not(.dragging)')];
                return draggableElements.reduce((closest, child) => {
                    const box = child.getBoundingClientRect();
                    const offset = y - box.top - box.height / 2;
                    if (offset < 0 && offset > closest.offset) {
                        return { offset: offset, element: child };
                    } else {
                        return closest;
                    }
                }, { offset: Number.NEGATIVE_INFINITY }).element;
            }

            function updateRiddleIndexes() {
                const items = container.querySelectorAll('.riddle-nav-item');
                const orderData = [];

                items.forEach((item, index) => {
                    const newIndex = index + 1;
                    const riddleId = item.dataset.riddleId;

                    // 1. Mise à jour du numéro dans le badge à gauche
                    const badge = item.querySelector('.riddle-num-badge');
                    if (badge) badge.textContent = newIndex;

                    // 2. Mise à jour des indicateurs d'index dans le panneau de droite correspondant
                    const pane = document.getElementById('riddle-pane-' + riddleId);
                    if (pane) {
                        pane.querySelectorAll('.riddle-pane-index').forEach(el => {
                            el.textContent = newIndex;
                        });
                    }

                    orderData.push({
                        id: riddleId,
                        index: newIndex
                    });
                });

                fetch('{{ path('app_riddle_reorder_all') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ orders: orderData })
                }).catch(err => console.error('Erreur lors du réordonnancement:', err));
            }
        });
    </script>
{% endblock %}
