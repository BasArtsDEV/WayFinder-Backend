{% extends 'base.html.twig' %}

{% block title %}{{ treasureHunt.title }} - Modification{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/RiddleListEdit.css') }}">
{% endblock %}

{% block main %}
    <div class="container py-5">

        <div class="card border-0 rounded-4 mb-4 overflow-hidden">
            <div class="card-body p-4 p-md-5 bg-white">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            {% if treasureHunt.published %}
                                <span class="badge bg-success text-white fw-bold px-3 py-2 rounded-pill  text-uppercase fs-6" style="letter-spacing: 0.5px;">Disponible</span>
                            {% else %}
                                <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill  text-uppercase fs-6" style="letter-spacing: 0.5px;">En édition</span>
                            {% endif %}

                            <span class="badge bg-light text-dark fw-semibold px-3 py-2 rounded-pill border fs-6 d-flex align-items-center gap-2">
                                <i class="bi bi-puzzle-fill text-warning"></i>
                                {{ riddles|length }} énigme{{ riddles|length > 1 ? 's' : '' }}
                            </span>
                        </div>

                        <h1 class="fw-bold text-dark display-6 mb-2">{{ treasureHunt.title }}</h1>
                        <p class="text-muted mb-0">
                            Créée par l'équipe
                            <a href="{{ path('app_team_show', {id: treasureHunt.team.id}) }}" class="text-primary text-decoration-none fw-semibold">
                                {{ treasureHunt.team.name }}
                            </a>
                        </p>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <a href="{{ path('app_treasure_hunt_edit', {id: treasureHunt.id}) }}" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold d-flex align-items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                                <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"></path>
                            </svg>
                        </a>
                        {{ include('treasure_hunt/partials/_delete_button.html.twig') }}
                    </div>
                </div>
            </div>

            <div class="card-footer bg-light border-0 px-4 py-3 text-secondary">
                <div class="row g-3 align-items-center">
                    <div class="col-md-8">
                        <p class="mb-0"><strong>Description :</strong> {{ treasureHunt.description }}</p>
                    </div>
                    <div class="col-md-4 d-flex flex-column flex-md-row justify-content-md-end align-items-md-center gap-3 text-sm">
                        <div>
                            <span class="d-block text-muted" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px;">Création</span>
                            <strong class="text-dark">{{ treasureHunt.creationDate|date('d/m/Y') }}</strong>
                        </div>
                        <div>
                            <span class="d-block text-muted mb-1" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px;">Code d'invitation</span>
                            <div class="bg-white border rounded px-3 py-1.5 d-inline-flex align-items-center gap-2 "
                                 style="cursor: pointer; transition: all 0.2s ease;"
                                 onclick="navigator.clipboard.writeText('{{ treasureHunt.invitationCode }}'); alert('Code copié !');"
                                 title="Cliquer pour copier">
                                <span class="text-dark fw-bold" id="invitationCodeText">{{ treasureHunt.invitationCode }}</span>
                                <i class="bi bi-copy text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h4 fw-bold text-dark mb-0">Énigmes de la chasse</h2>
        </div>

        <div class="riddles-list d-flex flex-column gap-3 mb-4">
            {% for index, riddle in riddles %}
                <div class="card border-0  rounded-4 p-2">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <span class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-bold " style="width: 32px; height: 32px; font-size: 0.9rem;">
                                    {{ index + 1 }}
                                </span>
                                <h3 class="h5 fw-bold text-dark mb-0">{{ riddle.title }}</h3>
                            </div>

                            {% if riddle is instanceof('App\\Entity\\RiddleQCM') %}
                                <span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill">QCM</span>
                            {% elseif riddle is instanceof('App\\Entity\\RiddleGPS') %}
                                <span class="badge bg-info-subtle text-info-emphasis px-2.5 py-1.5 rounded-pill">GPS</span>
                            {% elseif riddle is instanceof('App\\Entity\\RiddleQRCode') %}
                                <span class="badge bg-primary-subtle text-primary px-2.5 py-1.5 rounded-pill">QR Code</span>
                            {% elseif riddle is instanceof('App\\Entity\\RiddleText') %}
                                <span class="badge bg-secondary-subtle text-secondary-emphasis px-2.5 py-1.5 rounded-pill">Texte libre</span>
                            {% else %}
                                <span class="badge bg-secondary-subtle text-secondary-emphasis px-2.5 py-1.5 rounded-pill">Question simple</span>
                            {% endif %}
                        </div>

                        <p class="text-muted mb-3">{{ riddle.description }}</p>

                        {% if riddle.img %}
                            <div class="mb-3 text-center">
                                <img src="data:image/png;base64,{{ riddle.imgBase64 }}"
                                     alt="{{ riddle.imgDescription ?? 'Image de l\'énigme' }}"
                                     class="img-fluid rounded-3 border " style="max-height: 250px;" />
                            </div>
                        {% endif %}

                        <div class="bg-light p-3 rounded-3 mb-3">
                            {% if riddle is instanceof('App\\Entity\\RiddleQCM') %}
                                <p class="mb-2"><strong>Question :</strong> {{ riddle.question }}</p>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <strong class="d-block text-muted small mb-1">Réponses possibles :</strong>
                                        <ul class="mb-0 ps-3">
                                            {% for choice in riddle.choices %}
                                                <li>{{ choice.choice }}</li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                    <div class="col-md-6">
                                        <strong class="d-block text-muted small mb-1">Réponses attendues :</strong>
                                        <ul class="mb-0 ps-3 text-success fw-semibold">
                                            {% for choice in riddle.choices|filter(c => c.isRight)|map(c => c.choice) %}
                                                <li>{{ choice }}</li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                </div>
                            {% elseif riddle is instanceof('App\\Entity\\RiddleGPS') %}
                                <p class="mb-1"><strong>Lieu :</strong> {{ riddle.locationName ?? 'Non spécifié' }}</p>
                                <p class="mb-3"><strong>Coordonnées :</strong> Latitude {{ riddle.latitude }}, Longitude {{ riddle.longitude }}</p>
                                <div class="overflow-hidden rounded border">
                                    {{ ux_map(map, {style: 'height: 250px; width: 100%;'}) }}
                                </div>
                            {% elseif riddle is instanceof('App\\Entity\\RiddleQRCode') %}
                                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                                    <div>
                                        <p class="mb-1"><strong>URL cible :</strong></p>
                                        <a href="{{ riddle.url }}" target="_blank" class="text-decoration-none text-primary text-break">{{ riddle.url }}</a>
                                    </div>
                                    <div class="ms-md-auto text-center">
                                        <img src="{{ qr_code_url(riddle.url) }}" alt="QR code" class="img-thumbnail bg-white p-2 " style="width: 130px; height: 130px;"/>
                                    </div>
                                </div>
                            {% elseif riddle is instanceof('App\\Entity\\RiddleText') %}
                                <p class="mb-1"><strong>Question :</strong> {{ riddle.question }}</p>
                                <p class="mb-0 text-success"><strong>Réponse attendue :</strong> {{ riddle.expectedAnswer }}</p>
                            {% endif %}
                        </div>

                        <div class="d-flex justify-content-end align-items-center gap-2">
                            <form action="{{ path('app_riddle_reorder', {id: riddle.id, direction: 'up'}) }}" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" aria-label="Monter">
                                    ↑
                                </button>
                            </form>
                            <form action="{{ path('app_riddle_reorder', {id: riddle.id, direction: 'down'}) }}" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" aria-label="Descendre">
                                    ↓
                                </button>
                            </form>
                            <a href="{{ path('app_riddle_edit', {id: riddle.id}) }}" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                                Éditer
                            </a>

                            <form method="post" action="{{ path('app_riddle_delete', {id: riddle.id}) }}" class="d-inline" onsubmit="return confirm('Es-tu sûr de vouloir supprimer cette énigme ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ riddle.id) }}">
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold">
                                    Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="text-center py-5 bg-white rounded-4 ">
                    <p class="text-muted fst-italic mb-0">Aucune énigme pour le moment.</p>
                </div>
            {% endfor %}
        </div>

        <div class="text-center mb-5">
            <div class="btn-group" data-turbo="false">
                <button type="button" class="btn btn-primary rounded-pill px-4 py-2.5  fw-semibold text-white dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    + Ajouter une énigme
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="{{ path('app_riddle_new', {huntId: treasureHunt.id, type: 'text'}) }}">Question simple</a></li>
                    <li><a class="dropdown-item" href="{{ path('app_riddle_new', {huntId: treasureHunt.id, type: 'qcm'}) }}">Question QCM</a></li>
                    <li><a class="dropdown-item" href="{{ path('app_riddle_new', {huntId: treasureHunt.id, type: 'gps'}) }}">Aller à des coordonnées GPS</a></li>
                    <li><a class="dropdown-item" href="{{ path('app_riddle_new', {huntId: treasureHunt.id, type: 'qrcode'}) }}">Trouver un QR Code</a></li>
                </ul>
            </div>
        </div>
    </div>
{% endblock %}
