{% extends 'base.html.twig' %}

{% block title %}Mes chasses au trésor{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('styles/team/show.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block main %}
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="fw-bold fs-2 text-dark m-0 d-flex align-items-center gap-3">
                <i class="bi bi-map text-success"></i> Mes chasses au trésor
            </h1>
            <a href="{{ path('app_treasure_hunt_new') }}" class="btn btn-success rounded-pill px-4 py-2 fw-medium shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i> Créer une chasse
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            {{ include('treasure_hunt/partials/_treasure_hunts_display.html.twig', {
                treasureHunts: treasureHunts,
                showTeam: true,
                emptyMessage: 'Vous ne participez à aucune chasse au trésor pour le moment.',
            }) }}
        </div>
    </div>
{% endblock %}
