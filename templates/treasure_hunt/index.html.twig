{% extends 'base.html.twig' %}

{% block title %}{{ 'treasure_hunt.my_hunts'|trans }}{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('styles/treasure_hunt/list.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block main %}
    <div class="container py-5">
        <div class="page-header">
            <h1 class="h3 fw-bold mb-0 d-flex align-items-center gap-2">
                {{ 'treasure_hunt.my_hunts'|trans }}
                <span class="hunt-count" title="{{ treasureHunts|length }} chasse{{ treasureHunts|length > 1 ? 's' }}">{{ treasureHunts|length }}</span>
            </h1>
            {% if is_granted('TREASURE_HUNT_ADD') %}
                <a href="{{ path('app_treasure_hunt_new') }}" class="btn-app-primary">
                    <i class="bi bi-plus-circle"></i> {{ 'treasure_hunt.create'|trans }}
                </a>
            {% endif %}
        </div>

        <div class="card border-0 rounded-4 p-3 p-md-4 bg-white">
            {{ include('treasure_hunt/partials/_treasure_hunts_display.html.twig', {
                treasureHunts: treasureHunts,
                showTeam: true,
                emptyMessage: 'treasure_hunt.empty_mine'|trans,
            }) }}
        </div>
    </div>
{% endblock %}
