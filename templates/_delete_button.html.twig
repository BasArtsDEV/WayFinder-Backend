<form method="post"
      action="{{ action_path }}"
      class="d-inline"
      onsubmit="return confirm('{{ (confirm_message|default('delete_button.confirm'|trans))|e('js') }}');">

    <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_name) }}">

    <button type="submit" class="btn btn-app-danger" aria-label="{{ 'common.delete'|trans }}" title="{{ 'common.delete'|trans }}">
        <i class="bi bi-trash me-1"></i> {{ 'common.delete'|trans }}
    </button>
</form>
