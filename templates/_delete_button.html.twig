<form method="post"
      action="{{ action_path }}"
      class="d-inline"
      onsubmit="return confirm('{{ confirm_message|default('Êtes-vous sûr de vouloir supprimer cet élément ?') }}');">

    <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_name) }}">

    <button type="submit" class="btn btn-app-danger" aria-label="Supprimer" title="Supprimer">
        <i class="bi bi-trash me-1"></i> Supprimer
    </button>
</form>
