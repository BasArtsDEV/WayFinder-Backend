<form method="post"
      action="{{ action_path }}"
      class="d-inline"
      onsubmit="return confirm('{{ confirm_message|default('Êtes-vous sûr de vouloir supprimer cet élément ?') }}');">

    <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_name) }}">

    <button type="submit" class="btn btn-light border shadow-sm rounded-pill px-3 py-2 fw-medium text-danger" aria-label="Supprimer" title="Supprimer">
        <i class="bi bi-trash me-1 text-danger"></i> Supprimer
    </button>
</form>
