{% extends 'base.html.twig' %}

{% block title %}Paramètres du compte{% endblock %}

{% block main %}
    <div class="container-fluid py-4 px-lg-5">

        <div class="row g-4">
            <div class="col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <div class="nav flex-column nav-pills gap-1" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                        <button class="nav-link active text-start py-3 px-3 rounded-3 fw-medium d-flex align-items-center" id="v-pills-profile-tab" data-bs-toggle="pill" data-bs-target="#v-pills-profile" type="button" role="tab" aria-controls="v-pills-profile" aria-selected="true">
                            <i class="bi bi-person fs-5 me-3"></i> Paramètres du profil
                        </button>
                        <button class="nav-link text-start py-3 px-3 rounded-3 fw-medium d-flex align-items-center text-dark" id="v-pills-security-tab" data-bs-toggle="pill" data-bs-target="#v-pills-security" type="button" role="tab" aria-controls="v-pills-security" aria-selected="false">
                            <i class="bi bi-lock fs-5 me-3"></i> Mot de passe
                        </button>
                        <button class="nav-link text-start py-3 px-3 rounded-3 fw-medium d-flex align-items-center text-dark" id="v-pills-preferences-tab" data-bs-toggle="pill" data-bs-target="#v-pills-preferences" type="button" role="tab" aria-controls="v-pills-preferences" aria-selected="false">
                            <i class="bi bi-bell fs-5 me-3"></i> Langues
                        </button>
                        <button class="nav-link text-start py-3 px-3 rounded-3 fw-medium d-flex align-items-center text-dark" id="v-pills-verification-tab" data-bs-toggle="pill" data-bs-target="#v-pills-verification" type="button" role="tab" aria-controls="v-pills-verification" aria-selected="false">
                            <i class="bi bi-shield-check fs-5 me-3"></i> Suppression
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5 bg-white">
                    <div class="tab-content" id="v-pills-tabContent">

                        <div class="tab-pane fade show active" id="v-pills-profile" role="tabpanel" aria-labelledby="v-pills-profile-tab">
                            <form method="POST" action="{{ path('app_profil_edit') }}" enctype="multipart/form-data">

                                <div class="d-flex align-items-center gap-4 mb-5 pb-4 border-bottom">
                                    <div class="position-relative">
                                        {% if user.avatar %}
                                            <div class="rounded-circle overflow-hidden shadow-sm" style="width: 105px; height: 105px;">
                                                {{ include('profile/partials/_avatar.html.twig', { user: user, size: 105 }) }}
                                            </div>
                                        {% else %}
                                            <div class="bg-secondary rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 105px; height: 105px; font-size: 2.5rem;">
                                                {{ user.username|slice(0, 1)|upper }}
                                            </div>
                                        {% endif %}

                                        <label for="avatar-input" class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm border border-white" style="width: 32px; height: 32px; cursor: pointer; background-color: #1a237e !important;">
                                            <i class="bi bi-camera-fill" style="font-size: 0.85rem;"></i>
                                        </label>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        <label for="avatar-input" class="btn btn-app-primary rounded-3 px-4 py-2 fw-medium shadow-sm mb-0">
                                            Changer
                                        </label>
                                        <input type="file" class="d-none" id="avatar-input" name="avatar" accept="image/*">

                                        {% if user.avatar %}
                                            <form action="{{ path('app_profil_avatar_delete') }}" method="post" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete-avatar-' ~ user.id) }}">
                                                <button type="submit" class="btn btn-light rounded-3 px-4 py-2 fw-medium text-secondary shadow-sm border">
                                                    Supprimer l'avatar
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label for="username-input" class="form-label fw-semibold text-dark small">Nom d'utilisateur <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control rounded-3 py-2 bg-light border-0" id="username-input" name="username" value="{{ user.username }}" required>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="lastname-input" class="form-label fw-semibold text-dark small">Nom <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control rounded-3 py-2 bg-light border-0" id="lastname-input" name="lastName" value="{{ user.lastName }}" required>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="firstname-input" class="form-label fw-semibold text-dark small">Prénom <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control rounded-3 py-2 bg-light border-0" id="firstname-input" name="firstName" value="{{ user.firstName }}" required>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="email-input" class="form-label fw-semibold text-dark small">Email</label>
                                        <input type="email" class="form-control rounded-3 py-2 bg-light border-0" id="email-input" name="email" value="{{ user.email|default('') }}" readonly>
                                    </div>

                                    <div class="col-12">
                                        <label for="banner-input" class="form-label fw-semibold text-dark small">Bannière</label>
                                        <input type="file" class="form-control rounded-3 py-2 bg-light border-0" id="banner-input" name="banner" accept="image/*">
                                        {% if user.banner %}
                                            <div class="mt-3">
                                                <img src="{{ user.banner }}" alt="Bannière" class="img-fluid rounded-3 shadow-sm" style="max-height: 120px; object-fit: cover; width: 100%;">
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="mt-5 pt-2">
                                    <button type="submit" class="btn btn-app-primary rounded-3 px-5 py-2 fw-medium shadow-sm">
                                        Enregistrer
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div class="tab-pane fade" id="v-pills-security" role="tabpanel" aria-labelledby="v-pills-security-tab">
                            <h4 class="fw-bold mb-4 text-dark">Sécurité et Mot de passe</h4>
                            <div class="d-flex align-items-center justify-content-between p-4 bg-light rounded-4">
                                <div>
                                    <h6 class="mb-1 fw-bold text-dark">Mot de passe du compte</h6>
                                    <p class="text-muted small mb-0">Modifiez régulièrement votre mot de passe pour assurer la sécurité de votre profil.</p>
                                </div>
                                <a href="{{ path('app_forgot_password_request') }}" class="btn btn-app-primary rounded-3 px-4 py-2 fw-medium shadow-sm">
                                    Changer le mot de passe
                                </a>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="v-pills-preferences" role="tabpanel" aria-labelledby="v-pills-preferences-tab">
                            <h4 class="fw-bold mb-4 text-dark">Préférences d'affichage</h4>
                            <form method="POST" action="">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label for="language_select" class="form-label fw-semibold text-dark small">Langue</label>
                                        <select id="language_select" name="locale" class="form-select rounded-3 py-2 bg-light border-0">
                                            <option value="fr" {% if app.request.locale == 'fr' %}selected{% endif %}>Français</option>
                                            <option value="en" {% if app.request.locale == 'en' %}selected{% endif %}>English</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="timezone_select" class="form-label fw-semibold text-dark small">Fuseau horaire</label>
                                        <select id="timezone_select" name="timezone" class="form-select rounded-3 py-2 bg-light border-0">
                                            {% set userTimezone = app.user.timezone|default('Europe/Paris') %}
                                            {% for tz, label in {
                                                UTC: 'UTC (UTC +00:00)',
                                                'Europe/London': 'Londres (UTC +00:00 / +01:00 DST)',
                                                'Europe/Paris': 'Paris, Bruxelles, Berlin (UTC +01:00 / +02:00 DST)',
                                                'America/New_York': 'New York, Toronto (UTC -05:00 / -04:00 DST)',
                                                'America/Los_Angeles': 'Los Angeles (UTC -08:00 / -07:00 DST)',
                                                'Asia/Tokyo': 'Tokyo (UTC +09:00)',
                                            } %}
                                                <option value="{{ tz }}" {% if userTimezone == tz %}selected{% endif %}>
                                                    {{ label }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>

                                <div class="mt-5 pt-2">
                                    <button type="submit" class="btn btn-app-primary rounded-3 px-5 py-2 fw-medium shadow-sm">
                                        Enregistrer
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div class="tab-pane fade" id="v-pills-verification" role="tabpanel" aria-labelledby="v-pills-verification-tab">
                            <h4 class="fw-bold mb-4 text-danger">Zone de danger</h4>
                            <div class="p-4 bg-light rounded-4 border-start border-danger border-4">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <h6 class="mb-1 fw-bold text-danger">Supprimer le compte</h6>
                                        <p class="text-muted small mb-0">Une fois supprimé, toutes vos données personnelles seront définitivement effacées.</p>
                                    </div>
                                    <button type="button" class="btn btn-app-danger rounded-3 px-4 py-2 fw-medium shadow-sm" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                                        Supprimer mon compte
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger" id="deleteAccountModalLabel">Êtes-vous absolument sûr ?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="mb-3 text-secondary">Cette action supprimera définitivement votre compte utilisateur ainsi que l'ensemble des données associées.</p>
                    <div class="alert alert-warning small mb-0 rounded-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Attention : cette opération est irréversible.
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4 py-2" data-bs-dismiss="modal">Annuler</button>
                    <form action="" method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-account-' ~ app.user.id) }}">
                        <button type="submit" class="btn btn-app-danger rounded-pill px-4 py-2 fw-medium">Confirmer la suppression</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
