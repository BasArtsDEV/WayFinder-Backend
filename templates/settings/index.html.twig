{% extends 'base.html.twig' %}

{% block title %}{{ 'settings.title'|trans }}{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('styles/settings/settings.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block main %}
    <div class="container-fluid py-4 px-lg-5 settings-page">

        <div class="row g-4">
            <div class="col-lg-3">
                <div class="card border-0 rounded-4 p-3 bg-white">
                    <div class="settings-nav" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                        <button class="settings-nav-link active" id="v-pills-profile-tab" data-bs-toggle="pill" data-bs-target="#v-pills-profile" type="button" role="tab" aria-controls="v-pills-profile" aria-selected="true">
                            <i class="bi bi-person" aria-hidden="true"></i> {{ 'settings.nav.profile'|trans }}
                        </button>
                        <button class="settings-nav-link" id="v-pills-security-tab" data-bs-toggle="pill" data-bs-target="#v-pills-security" type="button" role="tab" aria-controls="v-pills-security" aria-selected="false">
                            <i class="bi bi-lock" aria-hidden="true"></i> {{ 'common.password'|trans }}
                        </button>
                        <button class="settings-nav-link" id="v-pills-preferences-tab" data-bs-toggle="pill" data-bs-target="#v-pills-preferences" type="button" role="tab" aria-controls="v-pills-preferences" aria-selected="false">
                            <i class="bi bi-translate" aria-hidden="true"></i> {{ 'settings.nav.preferences'|trans }}
                        </button>
                        <button class="settings-nav-link danger" id="v-pills-verification-tab" data-bs-toggle="pill" data-bs-target="#v-pills-verification" type="button" role="tab" aria-controls="v-pills-verification" aria-selected="false">
                            <i class="bi bi-trash" aria-hidden="true"></i>{{ 'settings.nav.deletion'|trans }}
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="card border-0 rounded-4 p-4 p-lg-5 bg-white">
                    <div class="tab-content" id="v-pills-tabContent">

                        <div class="tab-pane fade show active" id="v-pills-profile" role="tabpanel" aria-labelledby="v-pills-profile-tab">
                            <form method="POST" action="{{ path('app_profil_edit') }}" enctype="multipart/form-data">

                                <div class="d-flex flex-wrap align-items-center gap-4 mb-5 pb-4 border-bottom">
                                    <div class="position-relative">
                                        <div id="avatar-preview-wrapper"
                                             class="rounded-circle overflow-hidden {{ user.avatar ? '' : 'd-none' }}"
                                             style="width: 105px; height: 105px;">
                                            {% if user.avatar %}
                                                {{ include('profile/partials/_avatar.html.twig', { user: user, size: 105 }) }}
                                            {% endif %}
                                            <img id="avatar-preview-img" src="" alt="{{ 'settings.avatar.preview'|trans }}"
                                                 class="d-none w-100 h-100" style="object-fit: cover;">
                                        </div>

                                        <div id="avatar-initial"
                                             class="bg-secondary rounded-circle text-white d-flex align-items-center justify-content-center {{ user.avatar ? 'd-none' : '' }}"
                                             style="width: 105px; height: 105px; font-size: 2.5rem;">
                                            {{ user.username|slice(0, 1)|upper }}
                                        </div>

                                        <label for="avatar-input" class="avatar-edit-button" title="{{ 'settings.avatar.change_title'|trans }}">
                                            <i class="bi bi-camera-fill" aria-hidden="true"></i>
                                        </label>
                                    </div>
                                    <div class="d-flex flex-wrap align-items-center gap-3">
                                        <label for="avatar-input" class="btn-app-primary mb-0">
                                            {{ 'settings.avatar.change'|trans }}
                                        </label>
                                        <input type="file" class="d-none" id="avatar-input" name="avatar" accept="image/*">

                                        {% if user.avatar %}
                                            <a href="{{ path('app_profil_avatar_delete') }}" class="btn-app-secondary">
                                                {{ 'settings.avatar.delete'|trans }}
                                            </a>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label for="username-input" class="form-label fw-semibold text-dark small">{{ 'common.username'|trans }} <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="username-input" name="username" value="{{ user.username }}" required>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="lastname-input" class="form-label fw-semibold text-dark small">{{ 'common.last_name'|trans }} <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="lastname-input" name="lastName" value="{{ user.lastName }}" required>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="firstname-input" class="form-label fw-semibold text-dark small">{{ 'common.first_name'|trans }} <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="firstname-input" name="firstName" value="{{ user.firstName }}" required>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="email-input" class="form-label fw-semibold text-dark small">{{ 'settings.email'|trans }}</label>
                                        <input type="email" class="form-control" id="email-input" name="email" value="{{ user.email|default('') }}" readonly>
                                    </div>

                                    <div class="col-12">
                                        <label for="banner-input" class="form-label fw-semibold text-dark small">{{ 'settings.banner'|trans }}</label>
                                        <input type="file" class="form-control" id="banner-input" name="banner" accept="image/*">
                                        {% if user.banner %}
                                            <div class="mt-3">
                                                <img src="{{ user.banner }}" alt="{{ 'settings.banner'|trans }}" class="img-fluid rounded-3" style="max-height: 120px; object-fit: cover; width: 100%;">
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="mt-5 pt-2">
                                    <button type="submit" class="btn-app-primary">
                                        {{ 'common.save'|trans }}
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div class="tab-pane fade" id="v-pills-security" role="tabpanel" aria-labelledby="v-pills-security-tab">
                            <h4 class="fw-bold mb-4 text-dark">{{ 'settings.security.heading'|trans }}</h4>
                            <div class="settings-box">
                                <div>
                                    <h6 class="mb-1 fw-bold text-dark">{{ 'settings.security.account_password'|trans }}</h6>
                                    <p class="text-muted small mb-0">{{ 'settings.security.hint'|trans }}</p>
                                </div>
                                <a href="{{ path('app_forgot_password_request') }}" class="btn-app-primary change__password__btn">
                                    {{ 'settings.security.change_password'|trans }}
                                </a>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="v-pills-preferences" role="tabpanel" aria-labelledby="v-pills-preferences-tab">
                            <h4 class="fw-bold mb-4 text-dark">{{ 'settings.preferences.heading'|trans }}</h4>
                            <form method="POST" action="{{ path('app_settings_preferences') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('settings-preferences') }}">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label for="language_select" class="form-label fw-semibold text-dark small">{{ 'settings.preferences.language'|trans }}</label>
                                        <select id="language_select" name="locale" class="form-select">
                                            {% for locale in available_locales() %}
                                                <option value="{{ locale.code }}" {% if locale.active %}selected{% endif %}>{{ locale.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="timezone_select" class="form-label fw-semibold text-dark small">{{ 'settings.preferences.timezone'|trans }}</label>
                                        <select id="timezone_select" name="timezone" class="form-select">
                                            {% set userTimezone = app.user.timezone|default('Europe/Paris') %}
                                            {% for tz in timezones %}
                                                <option value="{{ tz }}" {% if userTimezone == tz %}selected{% endif %}>{{ tz }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>

                                <div class="mt-5 pt-2">
                                    <button type="submit" class="btn-app-primary">
                                        {{ 'common.save'|trans }}
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div class="tab-pane fade" id="v-pills-verification" role="tabpanel" aria-labelledby="v-pills-verification-tab">
                            <h4 class="fw-bold mb-4 text-danger">{{ 'settings.danger.heading'|trans }}</h4>
                            <div class="settings-box danger">
                                <div>
                                    <h6 class="mb-1 fw-bold text-danger">{{ 'settings.danger.delete_account'|trans }}</h6>
                                    <p class="text-muted small mb-0">{{ 'settings.danger.hint'|trans }}</p>
                                </div>
                                    <button type="button" class="btn-app-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                                        {{ 'settings.danger.delete_button'|trans }}
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger" id="deleteAccountModalLabel">{{ 'settings.modal.title'|trans }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'flash.close'|trans }}"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="mb-3 text-secondary">{{ 'settings.modal.body'|trans }}</p>
                    <div class="alert alert-warning small mb-0 rounded-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> {{ 'settings.modal.warning'|trans }}
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn-app-secondary" data-bs-dismiss="modal">{{ 'common.cancel'|trans }}</button>
                    <form action="{{ path('app_user_delete') }}" method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-account-' ~ app.user.id) }}">
                        <button type="submit" class="btn-app-danger">{{ 'settings.modal.confirm'|trans }}</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const input = document.getElementById('avatar-input');
            const wrapper = document.getElementById('avatar-preview-wrapper');
            const previewImg = document.getElementById('avatar-preview-img');
            const initial = document.getElementById('avatar-initial');
            let currentUrl = null;

            input.addEventListener('change', () => {
                const file = input.files[0];
                if (!file || !file.type.startsWith('image/')) return;

                if (currentUrl) URL.revokeObjectURL(currentUrl);
                currentUrl = URL.createObjectURL(file);

                Array.from(wrapper.children).forEach(el => {
                    if (el !== previewImg) el.classList.add('d-none');
                });

                previewImg.src = currentUrl;
                previewImg.classList.remove('d-none');
                wrapper.classList.remove('d-none');
                initial.classList.add('d-none');
            });
        });
    </script>
{% endblock %}
