{% set size = size|default(160) %}
{% set class = class|default('') %}
{% set border = border is defined ? border : true %}

{% if user.avatar %}
    <img src="{{ path('app_user_avatar', { id: user.id }) }}"
         alt="Avatar de {{ user.username }}"
         class="rounded-circle {{ class }}"
         style="width: {{ size }}px; height: {{ size }}px; object-fit: cover;"
         onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='inline-flex';">

    <div class="rounded-circle bg-secondary text-white align-items-center justify-content-center {{ class }}"
         style="width: {{ size }}px; height: {{ size }}px; font-size: {{ size * 0.55 }}px; line-height: 1; display: none;">
        <i class="bi bi-person-fill"></i>
    </div>
{% else %}
    <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center {{ class }}"
         style="width: {{ size }}px; height: {{ size }}px; font-size: {{ size * 0.55 }}px; line-height: 1;">
        <i class="bi bi-person-fill"></i>
    </div>
{% endif %}
