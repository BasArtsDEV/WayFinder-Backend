<div class="modal fade" id="{{ modal_id|default('editProfileModal') }}" tabindex="-1" aria-labelledby="{{ modal_id|default('editProfileModal') }}Label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form method="POST" action="{{ form_action|default(path('app_profil_edit')) }}" enctype="multipart/form-data">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark" id="{{ modal_id|default('editProfileModal') }}Label">
                        {{ modal_title|default('Modifier le profil') }}
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body py-4">

                    <div class="mb-3">
                        <label for="username-{{ user.id }}" class="form-label fw-semibold text-secondary">Nom d'utilisateur</label>
                        <input type="text" class="form-control rounded-3" id="username-{{ user.id }}" name="username" value="{{ user.username }}" required>
                    </div>

                    <div class="mb-3">
                        <label for="lastname-{{ user.id }}" class="form-label fw-semibold text-secondary">Nom</label>
                        <input type="text" class="form-control rounded-3" id="lastname-{{ user.id }}" name="lastName" value="{{ user.lastName }}" required>
                    </div>

                    <div class="mb-3">
                        <label for="firstname-{{ user.id }}" class="form-label fw-semibold text-secondary">Prénom</label>
                        <input type="text" class="form-control rounded-3" id="firstname-{{ user.id }}" name="firstName" value="{{ user.firstName }}" required>
                    </div>

                    <!-- Champ Avatar -->
                    <div class="mb-3">
                        <label for="avatar-{{ user.id }}" class="form-label fw-semibold text-secondary">Avatar</label>
                        <input type="file" class="form-control rounded-3" id="avatar-{{ user.id }}" name="avatar" accept="image/*">
                        {% if user.avatar %}
                            <div class="mt-3 text-center">
                                {{ include('profile/partials/_avatar.html.twig', {
                                    user: user,
                                    size: 80,
                                }) }}
                            </div>
                        {% endif %}
                    </div>

                    <div class="mb-3">
                        <label for="banner-{{ user.id }}" class="form-label fw-semibold text-secondary">Bannière</label>
                        <input type="file" class="form-control rounded-3" id="banner-{{ user.id }}" name="banner" accept="image/*">
                        {% if user.banner %}
                            <div class="mt-3 text-center">
                                <img src="{{ user.banner }}" alt="Bannière de {{ user.username }}" class="img-fluid rounded-3 style="max-height: 120px; object-fit: cover; width: 100%;">
                            </div>
                        {% endif %}
                    </div>

                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-medium">{{ submit_label|default('Enregistrer') }}</button>
                </div>
            </form>
        </div>
    </div>
</div>
