{% block stylesheets %}
    <link href="{{ asset('styles/profile/profile.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

<div class="user-profile-page">
    {% embed '_banner.html.twig' with { banner: user.banner } %}
        {% block overlay %}
            <div class="profile-banner-title-overlay">
                <div class="profile-avatar-wrapper mb-3">
                    {{ include('profile/partials/_avatar.html.twig', {
                        user: user,
                        size: 140,
                    }) }}
                </div>
                <h1 class="fw-bold text-white display-5 mb-1 text-shadow">@{{ user.username }}</h1>
                <p class="text-white-50 fs-5 mb-0 text-shadow">{{ user.firstName }} {{ user.lastName }}</p>
            </div>
        {% endblock %}
    {% endembed %}

    <div class="container profile-content-wrapper pb-5">

        {% if user is same as(app.user) or is_granted('ROLE_ADMIN') %}
            <div class="d-flex justify-content-end gap-2 mb-4">
                {% if user is same as(app.user) %}
                    <a href="{{ path('app_settings') }}" class="btn btn-app-secondary">
                        <i class="bi bi-pencil-square"></i> {{ 'profile.edit'|trans }}
                    </a>
                {% endif %}
            </div>
        {% endif %}

        <div class="row g-4">

            <div class="col-lg-8">
                <div class="card border-0 rounded-4 p-4 h-100 bg-white">
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-light">
                        <h3 class="fw-bold fs-4 text-dark m-0 d-flex align-items-center gap-2">
                            <i class="bi bi-person-vcard text-success"></i> {{ 'profile.general_info'|trans }}
                        </h3>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="info-item p-3 rounded-3 bg-light border border-light">
                                <span class="text-muted small d-block mb-1">{{ 'common.username'|trans }}</span>
                                <span class="fw-bold text-dark fs-6">@{{ user.username }}</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-item p-3 rounded-3 bg-light border border-light">
                                <span class="text-muted small d-block mb-1">{{ 'profile.email'|trans }}</span>
                                <span class="fw-bold text-dark fs-6">{{ user.email }}</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-item p-3 rounded-3 bg-light border border-light">
                                <span class="text-muted small d-block mb-1">{{ 'profile.full_name'|trans }}</span>
                                <span class="fw-bold text-dark fs-6">{{ user.firstName }} {{ user.lastName }}</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-item p-3 rounded-3 bg-light border border-light">
                                <span class="text-muted small d-block mb-1">{{ 'profile.registration_date'|trans }}</span>
                                <span class="fw-bold text-dark fs-6">{{ user.createdAt|date_formatter }}</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-item p-3 rounded-3 bg-light border border-light">
                                <span class="text-muted small d-block mb-1">{{ 'settings.preferences.timezone'|trans }}</span>
                                <span class="fw-bold text-dark fs-6">{{ user.timezone }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 rounded-4 p-4 h-100 bg-white">
                    <h3 class="fw-bold fs-5 text-dark mb-2 d-flex align-items-center gap-2">
                        <i class="bi bi-people-fill text-success"></i> {{ 'profile.teams'|trans }}
                    </h3>

                    {% set maxTeams = constant('App\\Entity\\User::MAX_TEAMS') %}
                    {% set userTeams = teams|default(user.teams) %}
                    {% set currentTeamsCount = userTeams|length %}
                    {% set teamsPercentage = (currentTeamsCount / maxTeams) * 100 %}
                    {% if teamsPercentage > 100 %}{% set teamsPercentage = 100 %}{% endif %}

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted" style="font-size: 0.8rem;">{{ 'profile.teams_joined'|trans }}</small>
                            <small class="fw-bold text-success" style="font-size: 0.8rem;">{{ currentTeamsCount }} / {{ maxTeams }}</small>
                        </div>
                        <div class="progress" style="height: 8px; background-color: #e9ecef; border-radius: 4px;">
                            <div class="progress-bar bg-success rounded-pill" role="progressbar" style="width: {{ teamsPercentage }}%; transition: width 0.6s ease;" aria-valuenow="{{ currentTeamsCount }}" aria-valuemin="0" aria-valuemax="{{ maxTeams }}"></div>
                        </div>
                    </div>

                    <div class="team-list d-flex flex-column gap-2">
                        {% if currentTeamsCount > 0 %}
                            {% for team in userTeams %}
                                {% set memberCount = team.users|length %}

                                <a href="{{ path('app_team_show', { id: team.id }) }}" class="team-card-item p-3 rounded-3 bg-light border border-light">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-2 min-w-0">
                                            <span class="fw-bold text-dark text-decoration-none hover-success text-truncate">
                                                {{ team.name }}
                                            </span>
                                            <span class="text-muted fw-normal fs-6">|</span>
                                            <span class="text-secondary small text-nowrap">
                                                {{ 'team.member_count'|trans({ count: memberCount }) }}
                                            </span>
                                        </div>

                                        {% if team.leader and team.leader.id == user.id %}
                                            <span class="badge bg-warning text-dark fw-semibold px-2 py-1 rounded-pill ms-2" title="Chef d'équipe">
                                                {{ 'team.leader_badge'|trans }}
                                            </span>
                                        {% endif %}
                                    </div>
                                </a>
                            {% endfor %}
                        {% else %}
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-people display-6 text-secondary opacity-50 mb-2"></i>
                                <p class="small mb-0">{{ 'profile.no_teams'|trans }}</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
