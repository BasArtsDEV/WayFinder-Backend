{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('styles/home/home.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block main %}
    <div class="welcome-page h-100">
        <div class="welcome-card text-center">
            <div class="chest-container">
                <video class="chest-img" autoplay muted playsinline>
                    <source src="{{ asset('icons/coffre-ouverture.webm') }}" type="video/webm">
                </video>
            </div>

            <h1 class="fw-bold mt-2">Bienvenue !</h1>

            {% if app.user %}
                <p class="welcome-text mb-2">
                    Ravi de te revoir, {{ app.user.username }} ! Prêt à reprendre l'aventure ?
                </p>
            {% else %}
                <p class="welcome-text mb-2">
                    Pour commencer à créer ou à jouer à une carte au trésor, veuillez utiliser un compte.
                </p>
            {% endif %}

            <hr class="separator">

            <div class="welcome-actions">
                {% if app.user %}
                    <a href="{{ path('app_profil') }}" class="btn-app-primary">
                        <span class="btn-icon-wrapper"><img src="{{ asset('icons/enter.png') }}" alt="" class="btn-action-icon"></span>
                        <span>Mon profil</span>
                    </a>

                    <a href="{{ path('app_logout') }}" class="btn-app-secondary">
                        <span class="btn-icon-wrapper"><i class="bi bi-box-arrow-right welcome-icon" aria-hidden="true"></i></span>
                        <span>Déconnexion</span>
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn-app-primary">
                        <span class="btn-icon-wrapper"><img src="{{ asset('icons/enter.png') }}" alt="" class="btn-action-icon"></span>
                        <span>Connexion</span>
                    </a>

                    <a href="{{ path('app_register') }}" class="btn-app-secondary">
                        <span class="btn-icon-wrapper"><img src="{{ asset('icons/img.png') }}" alt="" class="btn-action-icon"></span>
                        <span>Créer mon compte</span>
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
