{% extends 'base.html.twig' %}

{% set checkmailTitle = 'reset_password.check.title'|trans %}

{% block title %} {{ checkmailTitle }}{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('styles/security/login.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block main %}
    <div class="login-page-wrapper">
        <div class="login-card">
            <h1 class="login-title">{{ 'reset_password.check.heading'|trans }}</h1>

            <div class="login-form text-center">
                <p class="mb-4" style="color: #2d3748; font-size: 0.95rem; line-height: 1.5;">
                    {{ 'reset_password.check.message'|trans|raw }}
                </p>

                <p style="color: #718096; font-size: 0.9rem;">
                    {{ 'reset_password.check.no_email'|trans({ link: path('app_forgot_password_request') })|raw }}
                </p>
            </div>
        </div>
    </div>
{% endblock %}
